<!ENTITY github-pages
  "<note><para>Dette er GitHub Pages versjonen av denne boken, som brukes som en 
  sikkerhetskopi av hovedversjonene av boken. Den kan være litt utdatert og er 
  en rullerende utgivelse. Hvis du vil bruke hovedversjonen, gå til <ulink
  url='&glfs-website;/'>here</ulink>. Flere utgivelser finnes på
  <ulink url='&lfs-website;/glfs/view/'/>.</para></note>">
]]>
<!ENTITY github-pages "">

<!-- Dette kan se rart ut, men DocBook ENTITIES defineres én gang og kan ikke 
     omdefineres slik det ser ut, så den versjonen du vil at den skal vises må 
     være den som er definert først. Så dette ender opp med å se ut som en 
     if-else setning uten else. -->

<!ENTITY source-profile
  "<para>Nå henter du hovedprofilen:</para>
   <screen><userinput>source /etc/profile</userinput></screen>">

<!ENTITY abi-break
  "<important><para>Oppdatering av denne pakken er kjent 
  å bryte ABI.</para></important>">

<!ENTITY meson-cross
  "<important><para>Installasjonsinstruksjonene for lib32 krever de nye Meson 
  kryssfiler fra <ulink
  url='&mlfs-root;/chapter08/meson.html'>MLFS</ulink>, noen
  <parameter>--libdir=/usr/lib32</parameter> har blitt flyttet til kryssfilene 
  og vises ikke lenger i instruksjonene. Installer de nye kryssfilene slik at 
  32-bits biblioteker ikke blir installert i <filename
  class='directory'>/usr/lib</filename>.</para></important>">

<!ENTITY parallel_issues
  "<note><para>Denne pakken kan av og til feile når man 
  bygger med flere prosessorer. Se <xref
  linkend='parallel-builds'/> for mer informasjon.</para></note>">

<!ENTITY shell-env
  "<note><para>Hvis du installerer i chroot-miljøet, må du 
  sørge for å eksportere <envar>SHELL</envar> miljøvariabelen 
  eller konfigurasjonen av pakken vil 
  mislykkes.</para></note>">

<!ENTITY gi-doc-disable
  "Tillat bygging av denne pakken uten <xref linkend='gi-docgen'/>
  installert. Hvis du har <xref linkend='gi-docgen'/> installert og 
  du ønsker å gjenoppbygge og installere API-dokumentasjonen, en
  <command>meson configure</command> kommandoen vil tilbakestille dette 
  alternativet.">

<!ENTITY build-use-network
  "<note><para>En nettverkstilkobling er nødvendig for å bygge denne 
  pakken. Systemsertifikatlageret må kanskje konfigureres med
  <xref role='required' linkend='make-ca'/> før du bygger denne 
  pakken.</para></note>">

<!ENTITY options-configure
  "<note><para>Kjør <command>./configure --help</command> for en fullstendig liste 
  over alternativer.</para></note>">
<!ENTITY options-subconfigure
  "<note><para>Kjør <command>../configure --help</command> for en fullstendig
  liste over alternativer.</para></note>">
<!ENTITY options-meson
  "<note><para>Undersøk <filename>meson_options.txt</filename> eller
  <filename>meson.options</filename> for en fullstendig liste over
  alternativer.</para></note>">
<!ENTITY options-cmake
  "<note><para>For en fullstendig liste over alternativer og verdier, sørg for at du er 
  i en byggemappe, og kjør deretter <command>cmake -LAH ..</command>.
  </para></note>">

<!-- Previously were xincludes. Not all of them from BLFS/xincludes will be
     here, only take what we need. -->
<!ENTITY cmake-policy-version
  "<para><parameter>-D CMAKE_POLICY_VERSION_MINIMUM=3.5</parameter>:
  Denne bryteren tillater bygging av denne pakken med cmake-4.0 eller nyere.</para>">
<!ENTITY cmake-skip-install-rpath
  "<!-- https://wiki.debian.org/RpathIssue/
        https://security.stackexchange.com/questions/161799/ -->
  <para><parameter>-D CMAKE_SKIP_INSTALL_RPATH=ON</parameter>:
  Denne bryteren gjør at <command>cmake</command> fjerner hardkodede biblioteksøk 
  stier (rpath) når du installerer en binær kjørbar fil eller et delt bibliotek. 
  Denne pakken trenger ikke rpath når den er installert på standard 
  plassering, og rpath kan noen ganger forårsake uønskede effekter eller til og 
  med sikkerhetsproblemer.</para>">
<!ENTITY long-build-time
  "<note><para>Dette kan ta litt tid å bygge. Gjør gjerne noe annet 
  mens dette bygges.</para></note>">
<!-- Put &install-stdin; in <note> tags. This is done for revision-specific
     commands. Trying to put &install-stdin; in <phrase> outside a <para> leads
     to a validation error. -->
<!ENTITY install-stdin
  "<para>Ovennevnte <command>install</command> command(er) trenger litt 
  forklaring. Vanligvis i bøkene når konfigurasjonsfiler opprettes,
  <command>cat</command> brukes. Den bruker en Bash funksjon som heter
  <quote>heredoc</quote> som tar valgfritt flere linjer med inndata inntil et 
  gitt begrep, og videresender det til noe. I
  <command>cat</command> kommandoen, heredoc brukes til å mate inn
  <filename>/dev/stdin</filename>, og <command>cat</command> skriver fra
  <filename>/dev/stdin</filename> til den angitte filen.</para>
  <para>Når det gjelder <command>install</command>, bruken er mer dyptgående og 
  har mye mer på gang. I utgangspunktet gjør den det samme som
  <command>cat</command> commands. Det heredocs til
  <filename>/dev/stdin</filename> og videresendes til en fil;
  <command>install</command> gjør skrivingen. På en enklere måte, kopierer den 
  <filename>/dev/stdin</filename> til den angitte filen, som var fylt ut av 
  heredoc. Den har blitt brukt over <command>cat</command> slik at 
  tillatelsene kan angis og mappen filen må være i vil bli opprettet i 
  prosessen.</para>">
<!ENTITY meson-buildtype-release
  "<para><parameter>--buildtype=release</parameter>: Spesifiser en byggetype 
  som er egnet for stabile utgivelser av pakken, da standardtypen kan 
  produsere uoptimaliserte binærfiler.</para>">
<!ENTITY meson-wrap-nofallback
  "<para><parameter>--wrap-mode=nofallback</parameter>: Denne bryteren forhindrer
  <command>meson</command> fra å bruke reservetillegg for delprosjekter 
  for avhengighetsdeklarasjoner i byggefilene, og dermed stoppe nedlastingen av 
  valgfrie avhengigheter som ikke er installert på systemet.</para>">
<!ENTITY mingw-w64-msvcrt
  "<para><parameter>--with-default-msvcrt=msvcrt</parameter>: Fra og med
  <application>MinGW-w64-12.0.0</application>, Universal C Runtime 
  (UCRT), som ble lagt til i Windows 10, har blitt standard. Dette alternativet 
  gjør Microsoft Visual C Runtime (MSVCRT) til standard, som er mer 
  testet og har færre feil. Det sikrer også kompatibilitet med programvare 
  laget for eldre Windows versjoner.</para>">
<!ENTITY static-libraries
  "<para><parameter>--disable-static</parameter>: Denne bryteren forhindrer 
  installasjon av statiske versjoner av bibliotekene.</para>">

<!-- Fixes needed by various packages -->
<!ENTITY gnulib
  "<para>Først, gjør en rettelse som kreves av glibc-2.43 eller nyere:</para>
<screen><userinput remap='pre'>sed -r '/_GL_EXTERN_C/s/w?memchr|bsearch/(&amp;)/' \
    -i $(find -name \*.in.h)</userinput></screen>">
<!ENTITY x-nettle
  "<para>Tillat bygging mot Nettle-4.0 og høyere:</para>
<screen remap='pre'><userinput>sed -e '/sha.h/s/sha/sha1/'                  \
    -e '/sha1/a #include &lt;nettle/version.h&gt;' \
    -e 's/ctx, 20/ctx/'                      \
    -i os/xsha1.c</userinput></screen>">

<!-- Save repetition for multiple passes of a package. -->
<!ENTITY dbus-m64 "
<para>
  Installer <application>D-Bus</application> ved å kjøre følgende 
  kommandoer (du kan ønske å gjennomgå
  <filename>meson_options.txt</filename> filen først og legg til ønskede 
  parametere til <command>meson</command> kommandoen vist nedenfor):
</para>

<screen><userinput>mkdir build &amp;&amp;
cd    build &amp;&amp;

meson setup --prefix=/usr          \
            --buildtype=release    \
            --wrap-mode=nofallback \</userinput><userinput revision='openrc,sysv'>
            -D systemd=disabled    \</userinput><userinput>
            .. &amp;&amp;

ninja</userinput></screen>

    <para>
      Nå, som &root; bruker:
    </para>

<screen role='root'><userinput>ninja install</userinput></screen>

    <para>
      Hvis du bruker en DESTDIR installasjon,
      <command>dbus-daemon-launch-helper</command> må fikses 
      etterpå. Utsted følgende som &root; bruker:
    </para>

<screen role='root'><userinput>chown -v root:messagebus /usr/libexec/dbus-daemon-launch-helper &amp;&amp;
chmod -v      4750       /usr/libexec/dbus-daemon-launch-helper</userinput></screen>">

<!ENTITY rc-user-add
"mkdir -pv ~/.config/rc/{init,conf}.d &amp;&amp;
mkdir -pv ~/.config/rc/env &amp;&amp;
mkdir -pv ~/.config/rc/runlevels/{sysinit,boot,default,shutdown} &amp;&amp;
rc-update --user add">

