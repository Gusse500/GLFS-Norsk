  <sect2 role="package">
    <title>Introduksjon til nv-codec-headers</title>

    <para>
      Pakken nv-codec-headers inneholder deklarasjoner for samhandling med 
      NVIDIA codec API-er. Denne pakken heter også ffnvcodec.
    </para>

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting: <ulink url="&nv-codec-headers-download;"/>
        </para>
      </listitem>
    </itemizedlist>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av nv-codec-headers</title>

    <para>
      Installer nv-codec-headers ved å kjøre følgende 
      kommandoer som &root; bruker:
    </para>

<screen role="root"><userinput>make PREFIX=/usr LIBDIR=share install</userinput></screen>

  </sect2>

