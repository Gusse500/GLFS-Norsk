<sect1 id="cmake" xreflabel="CMake-&cmake-version;">
  <?dbhtml filename="cmake.html"?>

  <title>CMake-&cmake-version;</title>

  <indexterm zone="cmake">
    <primary sortas="a-CMake">CMake</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til CMake</title>

    <para>
      CMake pakken inneholder et moderne verktøysett som brukes til å generere 
      Makefiler. Det er en etterfølger av det automatisk genererte
      <command>configure</command> skriptet og har som mål å være plattform og 
      kompilatoruavhengig. En betydelig bruker av CMake er KDE siden versjon 4.
    </para>

    &long-build-time;

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting: <ulink url="&cmake-download;"/>
        </para>
      </listitem>
    </itemizedlist>

