      </seglistitem>
    </segmentedlist>

    <variablelist>
      <bridgehead renderas="sect3">Korte Beskrivelser</bridgehead>
      <?dbfo list-presentation="list"?>
      <?dbhtml list-presentation="table"?>

      <varlistentry id="wget-prog">
        <term><command>wget</command></term>
        <listitem>
          <para>
            henter filer fra nettet ved hjelp av HTTP, HTTPS og FTP 
            protokollene. Den er designet for å være ikke-interaktiv, 
            for bakgrunnsoperasjoner eller uovervåkede operasjoner.
          </para>
          <indexterm zone="wget wget-prog">
            <primary sortas="b-wget">wget</primary>
          </indexterm>
        </listitem>
      </varlistentry>

    </variablelist>

  </sect2>

