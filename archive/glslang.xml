<sect1 id="glslang" xreflabel="Glslang-&glslang-version;">
  <?dbhtml filename="glslang.html"?>

  <title>Glslang-&glslang-version;</title>

  <indexterm zone="glslang">
    <primary sortas="a-glslang">Glslang</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til Glslang</title>

    <para>
      Glslang pakken inneholder et brukergrensesnitt 
      og en validator for OpenGL, OpenGL ES og Vulkan shadere.
    </para>

    &long-build-time;

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting: <ulink url="&glslang-download-http;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Nedlasting (FTP): <ulink url="&glslang-download-ftp;"/>
        </para>
      </listitem>
    </itemizedlist>

<!--
    <bridgehead renderas="sect3">Ytterligere Nedlastinger</bridgehead>
    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nødvendig oppdatering:
          <ulink url="&dl-root;/glslang/glslang-&glslang-version;-SPIRV_install-1.patch"/>
        </para>
      </listitem>
    </itemizedlist>
-->

    <bridgehead renderas="sect3">Glslang Avhengigheter</bridgehead>

    <para role="required">
      <xref linkend="cmake"/> og
      <xref linkend="spirv-tools"/>
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av Glslang</title>

<!--
    <para>
      Først oppdaterer du pakken for å sikre at <filename
      class="libraryfile">libSPIRV</filename> vil bli installert:
    </para>

<screen><userinput>patch -Np1 -i ../glslang-&glslang-version;-SPIRV_install-1.patch</userinput></screen>
-->

    <para>
      Installer Glslang ved å kjøre følgende 
      kommandoer:
    </para>

<screen><userinput>mkdir build &amp;&amp;
cd    build &amp;&amp;

cmake -D CMAKE_INSTALL_PREFIX=/usr     \
      -D CMAKE_BUILD_TYPE=Release      \
      -D ALLOW_EXTERNAL_SPIRV_TOOLS=ON \
      -D BUILD_SHARED_LIBS=ON          \
      -D GLSLANG_TESTS=ON              \
      -G Ninja .. &amp;&amp;

ninja</userinput></screen>

    <para>
      For å teste resultatene, utsted: <command>ninja test</command>.
    </para>

    <para>
      Nå, som &root; bruker:
    </para>

<screen role="root"><userinput>ninja install</userinput></screen>

  </sect2>

  <sect2 role="installation">
    <title>lib32 Installasjon av Glslang</title>

    <para>
      Installer lib32-Glslang ved å kjøre følgende 
      kommandoer:
    </para>

<screen><userinput>rm -rf * &amp;&amp;
CC="gcc -m32" CXX="g++ -m32"           \
PKG_CONFIG_PATH=/usr/lib32/pkgconfig   \
cmake -D CMAKE_INSTALL_PREFIX=/usr     \
      -D CMAKE_INSTALL_LIBDIR=lib32    \
      -D CMAKE_BUILD_TYPE=Release      \
      -D ALLOW_EXTERNAL_SPIRV_TOOLS=ON \
      -D BUILD_SHARED_LIBS=ON          \
      -D GLSLANG_TESTS=ON              \
      -G Ninja .. &amp;&amp;

ninja</userinput></screen>

    <para>
      Nå, som &root; bruker:
    </para>

<screen role="root"><userinput>DESTDIR=$PWD/DESTDIR ninja install    &amp;&amp;
cp -vr DESTDIR/usr/lib32/* /usr/lib32 &amp;&amp;
rm -rf DESTDIR                        &amp;&amp;
ldconfig</userinput></screen>

  </sect2>

  <sect2 role="commands">
    <title>Parameterforklaringer</title>

    &options-cmake;

    <para>
      <parameter>-D ALLOW_EXTERNAL_SPIRV_TOOLS=ON</parameter>: Denne bryteren 
      lar byggesystemet bruke den systeminstallerte kopien av
      <xref linkend="spirv-tools" role="nodep"/>, i stedet for å laste ned og 
      installere sin egen kopi.
    </para>

    <para>
      <parameter>-D BUILD_SHARED_LIBS=ON</parameter>: Denne bryteren bygger delte 
      versjoner av bibliotekene, og installerer ikke statiske versjoner av dem.
    </para>

    <para>
      <parameter>-D GLSLANG_TESTS=ON</parameter>: Denne bryteren bygger 
      testene for pakken.
    </para>

  </sect2>

  <sect2 role="content">
    <title>Innhold</title>

    <segmentedlist>
      <segtitle>Installerte Programmer</segtitle>
      <segtitle>Installerte Biblioteker</segtitle>
      <segtitle>Installerte Mapper</segtitle>

      <seglistitem>
        <seg>
          glslang,
          glslang-validator (symlink to glslang), og
          spirv-remap
        </seg>
        <seg>
          libglslang,
          libglslang-default-resource-limits,
          libSPIRV, og
          libSPVRemapper
        </seg>
        <seg>
          /usr/include/glslang og
          /usr/lib/cmake/glslang
        </seg>
      </seglistitem>
    </segmentedlist>

    <variablelist>
      <bridgehead renderas="sect3">Korte Beskrivelser</bridgehead>
      <?dbfo list-presentation="list"?>
      <?dbhtml list-presentation="table"?>

      <varlistentry id="glslang-prog">
        <term><command>glslang</command></term>
        <listitem>
          <para>
            tilbyr et brukergrensesnitt og en validator for OpenGL, OpenGL ES 
            og Vulkan shadere
          </para>
          <indexterm zone="glslang glslang-prog">
            <primary sortas="b-glslang">glslang</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="libglslang">
        <term><filename class="libraryfile">libglslang</filename></term>
        <listitem>
          <para>
            inneholder funksjoner som gir et brukergrensesnitt og en validator 
            for OpenGL, OpenGL ES og Vulkan shadere til andre programmer
          </para>
          <indexterm zone="glslang libglslang">
            <primary sortas="c-libglslang">libglslang</primary>
          </indexterm>
        </listitem>
      </varlistentry>

<!-- Library removed in glslang-14.0.0
      <varlistentry id="libHLSL">
        <term><filename class="libraryfile">libHLSL</filename></term>
        <listitem>
          <para>
            gir et brukergrensesnitt for shaders som er i HLSL format
          </para>
          <indexterm zone="glslang libHLSL">
            <primary sortas="c-libHLSL">libHLSL</primary>
          </indexterm>
        </listitem>
      </varlistentry>
-->

      <varlistentry id="libSPIRV">
        <term><filename class="libraryfile">libSPIRV</filename></term>
        <listitem>
          <para>
            tilbyr et brukergrensesnitt og en generator for SPIR-V binærfiler
          </para>
          <indexterm zone="glslang libSPIRV">
            <primary sortas="c-libSPIRV">libSPIRV</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="libSPVRemapper">
        <term><filename class="libraryfile">libSPVRemapper</filename></term>
        <listitem>
          <para>
            gir en remapper for SPIR-V binærfiler
          </para>
          <indexterm zone="glslang libSPVRemapper">
            <primary sortas="c-libSPVRemapper">libSPVRemapper</primary>
          </indexterm>
        </listitem>
      </varlistentry>

    </variablelist>
  </sect2>
