          <indexterm zone="spirv-tools libSPIRV-Tools">
            <primary sortas="c-libSPIRV-Tools">libSPIRV-Tools</primary>
          </indexterm>
        </listitem>
      </varlistentry>
    </variablelist>
  </sect2>
