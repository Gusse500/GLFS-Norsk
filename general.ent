                      <xref linkend='nvidia-r580'/>)">
<!ENTITY cuda-all   "(<xref linkend='cuda'/> or
                      <xref linkend='cuda-r580'/>)">
<!ENTITY nvidia "NVIDIA &nvidia-all;">
<!ENTITY nvidia-emph "<emphasis>NVIDIA</emphasis> &nvidia-all;">
<!ENTITY cuda "CUDA &cuda-all;">
<!ENTITY cuda-emph "<emphasis>CUDA</emphasis> &cuda-all;">

