  <sect2 role="package">
    <title>Introduksjon til ALSA biblioteket</title>

    <para>
      ALSA Library pakken inneholder
      ALSA biblioteket som brukes av programmer (inkludert ALSA
      Verktøy) krever tilgang til ALSA
      lydgrensesnittet.
    </para>

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting: <ulink url="&alsa-lib-download;"/>
        </para>
      </listitem>
    </itemizedlist>
    
    <bridgehead renderas="sect3">Ytterligere nedlastinger</bridgehead>
    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Anbefalt fil:
          <ulink url="https://www.alsa-project.org/files/pub/lib/alsa-ucm-conf-&alsa-lib-version;.tar.bz2"/>
        </para>
      </listitem>
<!--
      <listitem>
        <para>
          Anbefalt oppdatering:
          <ulink url="&dl-root;/alsa-ucm-conf-&alsa-lib-version;-upstream_fix-1.patch"/>
        </para>
      </listitem>
-->
    </itemizedlist>

    <bridgehead renderas="sect3">ALSA biblioteks avhengigheter</bridgehead>

    <bridgehead renderas="sect4">Anbefalt (kjøretid)</bridgehead>
    <para role="runtime">
      <phrase revision="sysv"><xref linkend="elogind"/></phrase>
      <phrase revision="systemd"><xref linkend="systemd"/></phrase>
    </para>

    <bridgehead renderas="sect4">Valgfri</bridgehead>
