<sect1 id="alsa-lib" xreflabel="alsa-lib-&alsa-lib-version;">
  <?dbhtml filename="alsa-lib.html"?>

  <title>alsa-lib-&alsa-lib-version;</title>

  <indexterm zone="alsa-lib">
    <primary sortas="a-alsa-lib">alsa-lib</primary>
