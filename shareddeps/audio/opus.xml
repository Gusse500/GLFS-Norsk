<sect1 id="opus" xreflabel="Opus-&opus-version;">
  <?dbhtml filename="opus.html"?>

  <title>Opus-&opus-version;</title>

  <indexterm zone="opus">
    <primary sortas="a-Opus">Opus</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til Opus</title>

    <para>
      Opus er et tapsfylt lydkomprimeringsformat 
      utviklet av Internet Engineering Task Force (IETF) som er 
      spesielt egnet for interaktiv tale og lyd overføring over 
      Internett. Denne pakken inneholder Opus utviklingsbiblioteket og 
      deklarasjonene.
    </para>

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting: <ulink url="&opus-download;"/>
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect4">Valgfri</bridgehead>
    <para role="optional">
      <ulink url="&blfs-svn;/general/doxygen.html">doxygen</ulink> og
      <ulink url="&blfs-svn;/general/texlive.html">texlive</ulink>
      (eller <ulink url="&blfs-svn;/general/tl-installer.html">
      install-tl-unx</ulink>)
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av Opus</title>

    <para>
      Installer Opus ved å kjøre følgende 
      kommandoer:
    </para>

<screen><userinput>mkdir build &amp;&amp;
cd    build &amp;&amp;

meson setup --prefix=/usr        \
            --buildtype=release  \
            -D docdir=/usr/share/doc/opus-&opus-version; &amp;&amp;

ninja</userinput></screen>

    <para>
      For å teste resultatene, utsted: <command>ninja test</command>.
    </para>

    <para>
      Nå, som <systemitem class="username">root</systemitem> bruker:
    </para>

<screen role="root"><userinput>ninja install</userinput></screen>

  </sect2>

  <sect2 role="installation">
    <title>lib32 Installasjon av Opus</title>

    <para>
      Installer lib32-Opus ved å kjøre følgende 
      kommandoer:
    </para>

<screen><userinput>rm -rf * &amp;&amp;
CC="gcc -m32" CXX="g++ -m32"         \
PKG_CONFIG_PATH=/usr/lib32/pkgconfig \
meson setup --prefix=/usr            \
            --libdir=/usr/lib32      \
            --buildtype=release &amp;&amp;

ninja</userinput></screen>

    <para>
      Nå, som <systemitem class="username">root</systemitem> bruker:
    </para>

<screen role="root"><userinput>DESTDIR=$PWD/DESTDIR ninja install    &amp;&amp;
cp -vr DESTDIR/usr/lib32/* /usr/lib32 &amp;&amp;
rm -rf DESTDIR                        &amp;&amp;
ldconfig</userinput></screen>

  </sect2>

