<sect1 id="libogg" xreflabel="libogg-&libogg-version;">
  <?dbhtml filename="libogg.html"?>


  <title>libogg-&libogg-version;</title>

  <indexterm zone="libogg">
    <primary sortas="a-Libogg">Libogg</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til libogg</title>

    <para>
      libogg Pakken inneholder Ogg filstrukturen. 
      Dette er nyttig for å opprette (koding) eller spille (dekoding) av en 
      enkel fysisk bitstrøm.
    </para>

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting: <ulink url="&libogg-download;"/>
        </para>
      </listitem>
    </itemizedlist>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av libogg</title>

    <para>
      Installer libogg ved å kjøre følgende 
      kommandoer:
    </para>

<screen><userinput>./configure --prefix=/usr    \
            --disable-static \
            --docdir=/usr/share/doc/libogg-&libogg-version; &amp;&amp;

make</userinput></screen>

    <para>
      Nå, som <systemitem class="username">root</systemitem> bruker:
    </para>

<screen role="root"><userinput>make install</userinput></screen>

  </sect2>

  <sect2 role="installation">
    <title>lib32 Installasjon av libogg</title>

    <para>
      Installer lib32-libogg ved å kjøre følgende 
      kommandoer:
    </para>

<screen><userinput>make distclean &amp;&amp;
CC="gcc -m32" CXX="g++ -m32"         \
./configure --prefix=/usr            \
            --libdir=/usr/lib32      \
            --host=i686-pc-linux-gnu \
            --disable-static &amp;&amp;

make</userinput></screen>

    <para>
      Nå, som <systemitem class="username">root</systemitem> bruker:
    </para>

<screen role="root"><userinput>make DESTDIR=$PWD/DESTDIR install     &amp;&amp;
cp -vr DESTDIR/usr/lib32/* /usr/lib32 &amp;&amp;
rm -rf DESTDIR                        &amp;&amp;
ldconfig</userinput></screen>

  </sect2>

  <sect2 role="commands">
    <title>Parameterforklaringer</title>

    &options-configure;

    &static-libraries;

  </sect2>

