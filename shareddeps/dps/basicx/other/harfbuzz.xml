<sect1 id="harfbuzz" xreflabel="HarfBuzz-&harfbuzz-version;">
  <?dbhtml filename="harfbuzz.html"?>

  <title>HarfBuzz-&harfbuzz-version;</title>

  <indexterm zone="harfbuzz">
    <primary sortas="a-HarfBuzz">HarfBuzz</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til HarfBuzz</title>

    <para>
      HarfBuzz Pakken inneholder en OpenType 
      tekstformingsmotor.
    </para>

    &long-build-time;

    &meson-cross;

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting: <ulink url="&harfbuzz-download;"/>
        </para>
      </listitem>
    </itemizedlist>
    
    <bridgehead renderas="sect3">HarfBuzz Avhengigheter</bridgehead>

    <para role="recommended">
      <xref role="first" linkend="freetype2"/>,
      <xref linkend="glib2"/> (påkrevd for Pango; GObject Introspection
      påkrevd for bygging av GNOME), og
      <xref linkend="icu"/>
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av HarfBuzz</title>

    <para>
      Installer HarfBuzz ved å kjøre følgende 
      kommandoer:
    </para>

<screen><userinput>mkdir build &amp;&amp;
cd    build &amp;&amp;

meson setup --prefix=/usr         \
            --buildtype=release   \
            -D graphite2=disabled \
            -D tests=disabled     \
            .. &amp;&amp;

ninja</userinput></screen>

    <para>
      
    </para>

    <para>
      Nå, som <systemitem class="username">root</systemitem> bruker:
    </para>

<screen role="root"><userinput>ninja install</userinput></screen>
  
  </sect2>

  <sect2 role="installation">
    <title>lib32 Installasjon av HarfBuzz</title>

    <para>
      Installer lib32-HarfBuzz ved å kjøre følgende 
      kommandoer:
    </para>

<screen><userinput>rm -rf * &amp;&amp;
meson setup --prefix=/usr         \
            --buildtype=release   \
            --cross-file=lib32    \
            -D cairo=disabled     \
            -D graphite2=disabled \
            -D tests=disabled     \
            .. &amp;&amp;

ninja</userinput></screen>

    <para>
      Nå, som <systemitem class="username">root</systemitem> bruker:
    </para>

<screen role="root"><userinput>DESTDIR=$PWD/DESTDIR ninja install    &amp;&amp;
cp -vr DESTDIR/usr/lib32/* /usr/lib32 &amp;&amp;
rm -rf DESTDIR                        &amp;&amp;
ldconfig</userinput></screen>

  </sect2>

  <sect2 role="commands">
    <title>Parameterforklaringer</title>

    &options-meson;

    &meson-buildtype-release;

    <para>
      <parameter>-D cairo=disabled</parameter>: Denne bryteren tvinger denne pakken 
      til ikke å lenke mot Cairo for lib32 bygget,
      ettersom den feilaktig vil tro at lib32-Cairo
      er installert hvis 64-bits sversjonen er installert.
    </para>

    <para>
      <parameter>-D graphite2=disabled</parameter>: Denne bryteren deaktiverer
      Graphite2 støtte, som ikke er i GLFS.
    </para>

    <para>
      <parameter>-D tests=disabled</parameter>: Denne bryteren deaktiverer bygging
      av tester.
    </para>

<!--
    <para>
      <parameter>-Dbenchmark=disabled</parameter>: Denne bryteren deaktiverer 
      nedlasting og bygging av google-benchmark
      delprosjekt, som krever <xref linkend="git"/>, og er ikke nyttig 
      for ikke-utviklere.
    </para>
-->
<!--
    <para>
      <option>-Ddocs=disabled</option>: Hvis <xref linkend="gtk-doc"/> er
      installert, blir dokumentasjonen bygget og installert. Denne bryteren 
      forhindrer det.
    </para>
-->
    
  </sect2>

  <sect2 role="content">
    <title>Innhold</title>

    <segmentedlist>
      <segtitle>Installerte Programmer</segtitle>
      <segtitle>Installerte Biblioteker</segtitle>
      <segtitle>Installerte Mapper</segtitle>

      <seglistitem>
        <seg>
          hb-info,
          hb-raster,
          hb-shape,
          hb-vector, og
          hb-subset
        </seg>
        <seg>
          libharfbuzz,
          libharfbuzz-gobject,
          libharfbuzz-gpu,
          libharfbuzz-icu,
          libharfbuzz-raster,
          libharfbuzz-vector, og
          libharfbuzz-subset
        </seg>
        <seg>
          /usr/include/harfbuzz,
          /usr/lib/cmake/harfbuzz, og
          /usr/share/gtk-doc/html/harfbuzz (valgfri)
        </seg>
      </seglistitem>
    </segmentedlist>

    <variablelist>
      <bridgehead renderas="sect3">Korte Beskrivelser</bridgehead>
      <?dbfo list-presentation="list"?>
      <?dbhtml list-presentation="table"?>

     <varlistentry id="hb-info">
       <term><command>hb-info</command></term>
       <listitem>
         <para>
           brukes til å samle informasjon om fonter som er installert på 
           systemet
         </para>
         <indexterm zone="harfbuzz hb-info">
           <primary sortas="b-hb-info">hb-info</primary>
         </indexterm>
       </listitem>
     </varlistentry>

<!-- No longer seen in 14.0.0
     <varlistentry id="hb-ot-shape-closure">
        <term><command>hb-ot-shape-closure</command></term>
        <listitem>
          <para>
            gir settet med tegn som finnes i en streng, representert som 
            enkelttegn og/eller navn på enkelttegn. Eksempel:
            <command>hb-ot-shape-closure
              /usr/share/fonts/dejavu/DejaVuSans.ttf "Hallo Verden."</command>
          </para>
          <indexterm zone="harfbuzz hb-ot-shape-closure">
            <primary sortas="b-hb-ot-shape-closure">hb-ot-shape-closure</primary>
          </indexterm>
        </listitem>
      </varlistentry>
-->

      <varlistentry id="hb-raster">
        <term><command>hb-raster</command></term>
        <listitem>
          <para>
            brukes til å gjengi formet tekst som et rasterbilde ved hjelp av en gitt skrifttype
          </para>
          <indexterm zone="harfbuzz hb-raster">
            <primary sortas="b-hb-raster">hb-raster</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="hb-shape">
        <term><command>hb-shape</command></term>
        <listitem>
          <para>
            brukes til å konvertere tekststrenger til posisjonerte tegn
          </para>
          <indexterm zone="harfbuzz hb-shape">
            <primary sortas="b-hb-shape">hb-shape</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="hb-subset">
        <term><command>hb-subset</command></term>
        <listitem>
          <para>
            brukes til å lage delsett av fonter og vise tekst ved hjelp av dem
          </para>
          <indexterm zone="harfbuzz hb-subset">
            <primary sortas="b-hb-subset">hb-subset</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="hb-vector">
        <term><command>hb-vector</command></term>
        <listitem>
          <para>
            brukes til å tegne tekst i SVG format med en gitt skrifttype
          </para>
          <indexterm zone="harfbuzz hb-vector">
            <primary sortas="b-hb-vector">hb-vector</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="hb-view">
        <term><command>hb-view</command></term>
        <listitem>
          <para>
            viser en grafisk visning av en strengform ved bruk av en 
            bestemt skrifttype som et sett med tegn. Utdataformatet er 
            automatisk definert av filtypen, og de støttede formatene 
            er ansi/png/svg/pdf/ps/eps. For eksempel:
            <command>hb-view --output-file=hello.png
              /usr/share/fonts/dejavu/DejaVuSans.ttf "Hallo Verden."</command>
          </para>
          <indexterm zone="harfbuzz hb-view">
            <primary sortas="b-hb-view">hb-view</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="libharfbuzz">
        <term><filename class="libraryfile">libharfbuzz</filename></term>
        <listitem>
          <para>
            er HarfBuzz tekstformingsbibliotek
          </para>
          <indexterm zone="harfbuzz libharfbuzz">
            <primary sortas="c-libharfbuzz">libharfbuzz</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="libharfbuzz-gobject">
        <term><filename class="libraryfile">libharfbuzz-gobject</filename></term>
        <listitem>
          <para>
            gir GObject integrasjon for HarfBuzz tekstformingsbiblioteket
          </para>
          <indexterm zone="harfbuzz libharfbuzz-gobject">
            <primary sortas="c-libharfbuzz-gobject">libharfbuzz-gobject</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="libharfbuzz-gpu">
        <term><filename class="libraryfile">libharfbuzz-gpu</filename></term>
        <listitem>
          <para>
            tilbyr API funksjoner for koding av tegnkonturer på CPU-en til 
            kompakte klatter som GPU-en dekoder og rasteriserer direkte til en 
            fragmentshader
          </para>
          <indexterm zone="harfbuzz libharfbuzz-gpu">
            <primary sortas="c-libharfbuzz-gpu">libharfbuzz-gpu</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="libharfbuzz-icu">
        <term><filename class="libraryfile">libharfbuzz-icu</filename></term>
        <listitem>
          <para>
            gir ICU integrasjon for HarfBuzz tekstformingsbiblioteket
          </para>
          <indexterm zone="harfbuzz libharfbuzz-icu">
            <primary sortas="c-libharfbuzz-icu">libharfbuzz-icu</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="libharfbuzz-raster">
        <term><filename class="libraryfile">libharfbuzz-raster</filename></term>
        <listitem>
          <para>
            tilbyr API funksjoner for rasterisering av tegn til punktgrafikk, 
            inkludert fargefonter
          </para>
          <indexterm zone="harfbuzz libharfbuzz-raster">
            <primary sortas="c-libharfbuzz-raster">libharfbuzz-raster</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="libharfbuzz-subset">
        <term><filename class="libraryfile">libharfbuzz-subset</filename></term>
        <listitem>
          <para>
            tilbyr API funksjoner for å utføre delsettingsoperasjoner på 
            fontfiler
          </para>
          <indexterm zone="harfbuzz libharfbuzz-subset">
            <primary sortas="c-libharfbuzz-subset">libharfbuzz-subset</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="libharfbuzz-vector">
        <term><filename class="libraryfile">libharfbuzz-vector</filename></term>
        <listitem>
          <para>
            tilbyr API funksjoner for å skrive ut tegn til vektorformater, 
            inkludert fargefonter. Bare SVG støttes for øyeblikket, men flere 
            formater kan komme senere.
          </para>
          <indexterm zone="harfbuzz libharfbuzz-vector">
            <primary sortas="c-libharfbuzz-vector">libharfbuzz-vector</primary>
          </indexterm>
        </listitem>
      </varlistentry>
    </variablelist>

  </sect2>

</sect1>
