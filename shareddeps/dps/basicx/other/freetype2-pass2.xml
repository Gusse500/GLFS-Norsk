<sect1 id="freetype2-pass2" xreflabel="FreeType-&freetype2-version; - Pass 2">
  <?dbhtml filename="freetype2-pass2.html"?>

  <title>FreeType-&freetype2-version; - Pass 2</title>

  <indexterm zone="freetype2-pass2">
    <primary sortas="a-FreeType-pass2">FreeType-Pass-2</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til FreeType2 - Pass 2</title>

    <para>
      Nå som <xref linkend="harfbuzz"/> har blitt installert, er det på tide 
      å kompilere denne pakken på nytt. Dette er andre omgang.
    </para>

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting: <ulink url="&freetype2-download;"/>
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">FreeType2 avhengigheter</bridgehead>

    <bridgehead renderas="sect4">Anbefalt</bridgehead>
    <para role="recommended">
      <xref linkend="freetype2-pass1"/>,
      <xref linkend="harfbuzz"/>,
      <xref linkend="libpng"/>, og
      <xref linkend="which"/>
    </para>

    <bridgehead renderas="sect4">Valgfri (for dokumentasjon)</bridgehead>
    <para role="optional">
      <ulink url="https://pypi.org/project/docwriter/">docwriter</ulink>
    </para>

  </sect2>
 
  <sect2 role="installation">
    <title>Installasjon av FreeType2 - Pass 2</title>

    <para>
      Bruk mappen du bygde den første omgangen fra på nytt, ellers må du 
      forberede kildetreet for kompilering på nytt, som vist i <xref
      linkend="freetype2-pass1"/>.
    </para>

    <para>
      Rens mappen:
    </para>

<screen><userinput>make distclean</userinput></screen>

    &freetype-m64;

  </sect2>

  <sect2 role="installation">
    <title>lib32 Installasjon av FreeType2 - Pass 2</title>

    &freetype-m32;

  </sect2>

  <sect2 role="commands">
    <title>Parameterforklaringer</title>

    &options-configure;

    <para>
      <parameter>--enable-freetype-config</parameter>: Denne bryteren 
      sørger for at manualsiden for freetype-config er installert.
    </para>

    <para>
      <option>--without-harfbuzz</option>: Hvis
      harfbuzz er installert før
      freetype uten
      freetype støtte, bruk denne bryteren for å unngå 
      en byggefeil.
    </para>

    &static-libraries;

    <!-- No longer valid with 2.10.1, /usr/bin/freetype-config is installed
         by the 'make install' command.
    <para>
      <command>cp builds/unix/freetype-config /usr/bin</command>: Manuelt 
      plasser freetype-konfigurasjonsprogrammet som trengs av andre programmer 
      når freetype biblioteket brukes.
    </para>
    -->

  </sect2>

  <sect2 role="content">
    <title>Innhold</title>

    <segmentedlist>
      <segtitle>Installert Program</segtitle>
      <segtitle>Installert Bibliotek</segtitle>
      <segtitle>Installerte Mapper</segtitle>

      <seglistitem>
        <seg>
          freetype-config
        </seg>
        <seg>
          libfreetype
        </seg>
        <seg>
          /usr/include/freetype2 og
          /usr/share/doc/freetype-&freetype2-version;
        </seg>
      </seglistitem>
    </segmentedlist>

    <variablelist>
      <bridgehead renderas="sect3">Korte Beskrivelser</bridgehead>
      <?dbfo list-presentation="list"?>
      <?dbhtml list-presentation="table"?>

      <varlistentry id="freetype-config-pass2">
        <term><command>freetype-config</command></term>
        <listitem>
          <para>
            brukes til å få FreeType kompilering 
            og lenkeinformasjon
          </para>
          <indexterm zone="freetype2-pass2 freetype-config-pass2">
            <primary sortas="b-freetype-config-pass2">freetype2-config</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="libfreetype-pass2">
        <term><filename class="libraryfile">libfreetype</filename></term>
        <listitem>
          <para>
            inneholder funksjoner for gjengivelse av ulike skrifttyper, som 
            for eksempel TrueType og Type1
          </para>
          <indexterm zone="freetype2-pass2 libfreetype-pass2">
            <primary sortas="c-libfreetype-pass2">libfreetype</primary>
          </indexterm>
        </listitem>
      </varlistentry>

    </variablelist>

  </sect2>

</sect1>
