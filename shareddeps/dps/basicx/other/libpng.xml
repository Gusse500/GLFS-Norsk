<sect1 id="libpng" xreflabel="libpng-&libpng-version;">
  <?dbhtml filename="libpng.html"?>

  <title>libpng-&libpng-version;</title>

  <indexterm zone="libpng">
    <primary sortas="a-libpng">libpng</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til libpng</title>

    <para>
      libpng pakken inneholder biblioteker som brukes 
      av andre programmer for å lese og skrive PNG filer. PNG formatet 
      ble utviklet som en erstatning for GIF og, i mindre grad, TIFF, 
      med mange forbedringer og utvidelser og mangel på patentproblemer.
    </para>

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting: <ulink url="&libpng-download;"/>
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">Ytterligere Nedlastinger</bridgehead>
    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Anbefalt oppdatering for å inkludere animert png funksjonalitet i 
          libpng (kreves for å bruke systemets libpng i Firefox, Seamonkey, og
          Thunderbird): <ulink url="&apng-patch;"/>
        </para>
      </listitem>
    </itemizedlist>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av libpng</title>

    <para>
      Hvis du vil oppdatere libpng for å støtte apng filer, bruk den her:
    </para>

<screen><userinput>gzip -cd ../libpng-&apng-version;-apng.patch.gz | patch -p1</userinput></screen>

    <para>
      Installer libpng ved å kjøre følgende 
      kommandoer:
    </para>

<screen><userinput>./configure --prefix=/usr --disable-static &amp;&amp;
make</userinput></screen>

    <para>
      Nå, som <systemitem class="username">root</systemitem> bruker:
    </para>

<screen role="root"><userinput>make install &amp;&amp;
mkdir -v /usr/share/doc/libpng-&libpng-version; &amp;&amp;
cp -v README libpng-manual.txt /usr/share/doc/libpng-&libpng-version;</userinput></screen>

  </sect2>

  <sect2 role="installation">
    <title>lib32 Installasjon av libpng</title>

    <para>
      Installer lib32-libpng ved å kjøre følgende 
      kommandoer:
    </para>

<screen><userinput>make distclean &amp;&amp;
CC="gcc -m32" CXX="g++ -m32"         \
PKG_CONFIG_PATH=/usr/lib32/pkgconfig \
./configure --prefix=/usr            \
            --libdir=/usr/lib32      \
            --host=i686-pc-linux-gnu \
            --disable-static &amp;&amp;

make</userinput></screen>

    <para>
      Nå, som <systemitem class="username">root</systemitem> bruker:
    </para>

<screen role="root"><userinput>make DESTDIR=$PWD/DESTDIR install     &amp;&amp;
cp -vr DESTDIR/usr/lib32/* /usr/lib32 &amp;&amp;
rm -rf DESTDIR                        &amp;&amp;
ldconfig</userinput></screen>

  </sect2>

  <sect2 role="commands">
    <title>Parameterforklaringer</title>

    &options-configure;

    &static-libraries;

  </sect2>

  <sect2 role="content">
    <title>Innhold</title>

    <segmentedlist>
      <segtitle>Installerte Programmer</segtitle>
      <segtitle>Installerte Biblioteker</segtitle>
      <segtitle>Installerte Mapper</segtitle>

      <seglistitem>
        <seg>
          libpng-config (symbollenke), libpng16-config, pngfix, og png-fix-itxt
        </seg>
        <seg>
          libpng
        </seg>
        <seg>
          /usr/include/libpng16 og
          /usr/share/doc/libpng-&libpng-version;
        </seg>
      </seglistitem>
    </segmentedlist>

    <variablelist>
      <bridgehead renderas="sect3">Korte Beskrivelser</bridgehead>
      <?dbfo list-presentation="list"?>
      <?dbhtml list-presentation="table"?>

      <varlistentry id="pngfix">
        <term><command>pngfix</command></term>
        <listitem>
          <para>
            tester, optimaliserer og fikser eventuelt zlib deklarasjonen i PNG filer. 
            Fjerner eventuelt tilleggsbiter fra filen ved fiksing.
          </para>
          <indexterm zone="libpng pngfix">
            <primary sortas="b-pngfix">pngfix</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="png-fix-itxt">
        <term><command>png-fix-itxt</command></term>
        <listitem>
          <para>
            fikser PNG filer som har et feil lengdefelt i 
            iTXt delene
          </para>
          <indexterm zone="libpng png-fix-itxt">
            <primary sortas="b-png-fix-itxt">png-fix-itxt</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="libpng-config">
        <term><command>libpng-config</command></term>
        <listitem>
          <para>
            er et skallskript som gir konfigurasjonsinformasjon 
            for applikasjoner som ønsker å bruke
            libpng
          </para>
          <indexterm zone="libpng libpng-config">
            <primary sortas="b-libpng-config">libpng-config</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="libpng-lin">
        <term><filename class="libraryfile">libpng</filename></term>
        <listitem>
          <para>
            inneholder rutiner som brukes til å opprette og 
            manipulere grafikkfiler i PNG formatet
          </para>
          <indexterm zone="libpng libpng-lin">
            <primary sortas="c-libpng">libpng</primary>
          </indexterm>
        </listitem>
      </varlistentry>

    </variablelist>

  </sect2>

</sect1>
