<sect1 id="util-macros" xreflabel="util-macros-&util-macros-version;">
  <?dbhtml filename="util-macros.html"?>

  <title>util-macros-&util-macros-version;</title>

  <indexterm zone="util-macros">
    <primary sortas="a-util-macros">util-macros</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til util-macros</title>

    <para>
      util-macros pakken inneholder
      m4 makroer som brukes av alle
      Xorg pakkene.
    </para>

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting: <ulink url="&util-macros-download;"/>
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">util-macros Avhengigheter</bridgehead>

    <bridgehead renderas="sect4">Påkrevd</bridgehead>
    <para role="required">
      <xref linkend="xorg-env"/> (bør være satt for at følgende instruksjoner 
      skal fungere)
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av util-macros</title>

    <para>
      Installer util-macros ved å kjøre følgende 
      kommandoer:
    </para>

<screen><userinput>./configure $XORG_CONFIG</userinput></screen>

    <para>
      Denne pakken leveres ikke med en testpakke.
    </para>

    <para>
      Nå, som <systemitem class="username">root</systemitem> bruker:
    </para>

<screen role="root"><userinput>make install</userinput></screen>

  </sect2>

  <sect2 role="commands">
    <title>Parameterforklaringer</title>

    &options-configure;

  </sect2>

