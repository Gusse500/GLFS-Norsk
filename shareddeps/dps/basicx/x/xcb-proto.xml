<sect1 id="xcb-proto" xreflabel="xcb-proto-&xcb-proto-version;">
  <?dbhtml filename="xcb-proto.html"?>


  <title>xcb-proto-&xcb-proto-version;</title>

  <indexterm zone="xcb-proto">
    <primary sortas="a-xcb-proto">xcb-proto</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til xcb-proto</title>

    <para>
      xcb-proto Pakken inneholder 
      XML-XCB protokollbeskrivelsene som libxcb
      bruker til å generere mesteparten av koden og API.
    </para>

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting (HTTP): <ulink url="&xcb-proto-download-http;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Nedlasting (FTP): <ulink url="&xcb-proto-download-ftp;"/>
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">xcb-proto Avhengigheter</bridgehead>

    <bridgehead renderas="sect4">Anbefalt</bridgehead>
    <para role="recommended">
      <xref linkend="xorg-env"/> (nødvendig for instruksjonene nedenfor)
    </para>

    <bridgehead renderas="sect4">Valgfri</bridgehead>
    <para role="optional">
      <xref linkend="libxml2"/>
      (nødvendig for å kjøre testene)
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av xcb-proto</title>

    <para>
      Installer xcb-proto ved å kjøre følgende 
      kommandoer:
    </para>

<screen><userinput>PYTHON=python3 ./configure $XORG_CONFIG</userinput></screen>

    <para>
      For å teste resultatene, utsted: <command>make check</command>.
    </para>

    <para>
      Nå, som <systemitem class="username">root</systemitem> bruker:
    </para>

<screen role="root"><userinput>make install</userinput></screen>

    <para>
      Hvis du oppgraderer fra versjon 1.15.1 eller eldre, må den gamle pkgconfig 
      filen fjernes. Utsted, som
      <systemitem class="username">root</systemitem> bruker:
    </para>

<screen role="nodump"><userinput>rm -f /usr/lib/pkgconfig/xcb-proto.pc</userinput></screen>

  </sect2>

  <sect2 role="commands">
    <title>Parameterforklaringer</title>

    &options-configure;

