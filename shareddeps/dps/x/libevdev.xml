  <!-- Begin Xorg libevdev Driver -->
  <sect2 id="libevdev" xreflabel="libevdev-&libevdev-version;">

  <sect2info>
    <date>$Date$</date>
  </sect2info>

    <title>libevdev &libevdev-version;</title>

    <indexterm zone="libevdev">
      <primary sortas="a-libevdev">libevdev</primary>
    </indexterm>

    <sect3 role="package">
      <title>Introduksjon til libevdev</title>

      <para>
        libevdev Pakken inneholder vanlige 
        funksjoner for Xorg inndatadrivere.
      </para>

      <itemizedlist spacing="compact">
        <listitem>
          <para>
            Nedlasting: <ulink url="&libevdev-download;"/>
          </para>
        </listitem>
      </itemizedlist>

    </sect3>

    <sect3 role="kernel" id="libevdev-kernel">
      <title>Kjernekonfigurasjon</title>

      <para>
        Aktiver følgende alternativer i kjernekonfigurasjonen og kompiler 
        kjernen på nytt om nødvendig:
      </para>

      <xi:include xmlns:xi="http://www.w3.org/2001/XInclude"
        href="libevdev-kernel.xml"/>

      <indexterm zone="libevdev libevdev-kernel">
        <primary sortas="d-libevdev">libevdev</primary>
      </indexterm>
    </sect3>

    <sect3 role="installation">
      <title>Installasjon av libevdev</title>

      <para>
        Installer libevdev ved å kjøre følgende 
      kommandoer:
      </para>

<screen><userinput>mkdir build &amp;&amp;
cd    build &amp;&amp;

meson setup ..                  \
      --prefix=/usr             \
      --buildtype=release       \
      -D documentation=disabled \
      -D tests=disabled &amp;&amp;

ninja</userinput></screen>

      <para>
        Regresjonstestene kan kjøres som <systemitem
        class="username">root</systemitem> bruker med <command>ninja
        test</command>, i en grafisk økt. Du må ha aktivert innstillingen 
        CONFIG_INPUT_UINPUT i kjernen for full testdekning. Hvis den er 
        aktivert som en modul, får modulen navnet
        <command>uinput</command> og må lastes inn før du kjører testene. Merk 
        at på noen systemer kan testene forårsake hard låsing og kreve omstart. 
        På bærbare datamaskiner vil systemet gå i hvilemodus og må vekkes for 
        å fullføre testpakkene.
      </para>

      <para>
        Nå, som <systemitem class="username">root</systemitem> bruker:
      </para>

<screen role="root"><userinput>ninja install</userinput></screen>
    </sect3>

    <sect3 role="commands">
      <title>Parameterforklaringer</title>

      &options-meson;

      <para>
        <parameter>-D tests=disabled</parameter>: Denne bryteren deaktiverer 
        bygging av tester, ettersom de er avhengige av Check.
      </para>

    </sect3>

    <sect3 role="content">
      <title>Innhold</title>

      <segmentedlist>
        <segtitle>Installerte Xorg Programmer</segtitle>
        <segtitle>Installert Xorg Bibliotek</segtitle>
        <segtitle>Installert Xorg Mappe</segtitle>

        <seglistitem>
          <seg>
            libevdev-tweak-device, mouse-dpi-tool, and touchpad-edge-detector
          </seg>
          <seg>
            libevdev
          </seg>
          <seg>
            /usr/include/libevdev-1.0
          </seg>
        </seglistitem>
      </segmentedlist>

      <variablelist>
        <bridgehead renderas="sect4">Korte Beskrivelser</bridgehead>
        <?dbfo list-presentation="list"?>
        <?dbhtml list-presentation="table"?>

        <varlistentry id="libevdev-tweak-device">
          <term><command>libevdev-tweak-device</command></term>
          <listitem>
            <para>
              er et verktøy for å endre noen egenskaper for kjerneenheter
            </para>
            <indexterm zone="libevdev libevdev-tweak-device">
              <primary sortas="b-libevdev-tweak-device">libevdev-tweak-device</primary>
            </indexterm>
          </listitem>
        </varlistentry>

        <varlistentry id="mouse-dpi-tool">
          <term><command>mouse-dpi-tool</command></term>
          <listitem>
            <para>
              er et verktøy for å estimere oppløsningen til en mus
            </para>
            <indexterm zone="libevdev mouse-dpi-tool">
              <primary sortas="b-mouse-dpi-tool">mouse-dpi-tool</primary>
            </indexterm>
          </listitem>
        </varlistentry>

        <varlistentry id="touchpad-edge-detector">
          <term><command>touchpad-edge-detector</command></term>
          <listitem>
            <para>
              touchpad-edge-detector er et verktøy som leser 
              berøringsplatehendelsene fra kjernen og beregner minimum og 
              maksimum for henholdsvis x og y koordinatene
            </para>
            <indexterm zone="libevdev touchpad-edge-detector">
              <primary sortas="b-touchpad-edge-detector">touchpad-edge-detector</primary>
            </indexterm>
          </listitem>
        </varlistentry>

        <varlistentry id="libevdev-lib">
          <term><filename class="libraryfile">libevdev</filename></term>
          <listitem>
            <para>
              er et bibliotek med Xorg driverinndatafunksjoner
            </para>
            <indexterm zone="libevdev libevdev-lib">
              <primary sortas="c-libevdev-lib">ebvdev</primary>
            </indexterm>
          </listitem>
        </varlistentry>

      </variablelist>

    </sect3>

  </sect2>
