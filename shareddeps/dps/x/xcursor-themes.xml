<sect1 id="xcursor-themes" xreflabel="xcursor-themes-&xcursor-themes-version;">
  <?dbhtml filename="xcursor-themes.html"?>

  <title>xcursor-themes-&xcursor-themes-version;</title>

  <indexterm zone="xcursor-themes">
    <primary sortas="a-xcursor-themes">xcursor-themes</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til xcursor-themes</title>

    <para>
      <application>xcursor-themes</application> pakken inneholder de animerte 
      markørtemaene redglass og whiteglass.
    </para>

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting (HTTP): <ulink url="&xcursor-themes-download-http;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Nedlasting (FTP): <ulink url="&xcursor-themes-download-ftp;"/>
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">xcursor-themes Avhengigheter</bridgehead>

    <bridgehead renderas="sect4">Påkrevd</bridgehead>
    <para role="required">
      <xref linkend="xorg7-app"/>
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av xcursor-themes</title>

    <para>
      Installer <application>xcursor-themes</application> ved å kjøre følgende 
      kommandoer:
    </para>

<screen><userinput>./configure --prefix=/usr &amp;&amp;
make</userinput></screen>

    <para>
      Denne pakken leveres ikke med en testpakke.
    </para>

    <para>
      Nå, som <systemitem class="username">root</systemitem> bruker:
    </para>

<screen role="root"><userinput>make install</userinput></screen>

  </sect2>

  <sect2 role="commands">
    <title>Parameterforklaringer</title>

    &options-configure;

  </sect2>

  <sect2 role="content">
    <title>Innhold</title>

    <segmentedlist>
      <segtitle>Installerte Programmer</segtitle>
      <segtitle>Installerte Biblioteker</segtitle>
      <segtitle>Installerte Mapper</segtitle>

      <seglistitem>
        <seg>Ingen</seg>
        <seg>Ingen</seg>
        <seg>
          /usr/share/icons/handhelds,
          /usr/share/icons/redglass, og
          /usr/share/icons/whiteglass
        </seg>
      </seglistitem>
    </segmentedlist>

  </sect2>

</sect1>
