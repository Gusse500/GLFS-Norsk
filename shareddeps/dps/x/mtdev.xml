<sect1 id="mtdev" xreflabel="mtdev-&mtdev-version;">
  <?dbhtml filename="mtdev.html"?>

  <title>mtdev-&mtdev-version;</title>

  <indexterm zone="mtdev">
    <primary sortas="a-mtdev">mtdev</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til mtdev</title>

    <para>
      mtdev pakken inneholder Multitouch Protocol 
      Translation Library som brukes til å transformere alle varianter av 
      kjerne MT (Multitouch) hendelser til den slottede type B 
      protokollen.
    </para>

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting (HTTP): <ulink url="&mtdev-download-http;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Nedlasting (FTP): <ulink url="&mtdev-download-ftp;"/>
        </para>
      </listitem>
    </itemizedlist>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av mtdev</title>

    <para>
      Installer mtdev ved å kjøre følgende 
      kommandoer:
    </para>

<screen><userinput>./configure --prefix=/usr --disable-static &amp;&amp;
make</userinput></screen>

    <para>
      Denne pakken leveres ikke med en testpakke.
    </para>

    <para>
      Nå, som <systemitem class="username">root</systemitem> bruker:
    </para>

<screen role="root"><userinput>make install</userinput></screen>
  </sect2>

  <sect2 role="commands">
    <title>Parameterforklaringer</title>

    &options-configure;

    &static-libraries;

  </sect2>

