  <!-- Begin Xorg Wacom Driver -->
  <sect2 id="xorg-wacom-driver" xreflabel="Xorg Wacom Driver-&xorg-wacom-driver-version;">

  <sect2info>
    <date>$Date$</date>
  </sect2info>

    <title>Xorg Wacom Driver-&xorg-wacom-driver-version;</title>

    <indexterm zone="xorg-wacom-driver">
      <primary sortas="a-xorg-wacom-driver">xorg-wacom-driver</primary>
    </indexterm>

    <sect3 role="package">
      <title>Introduksjon til Xorg Wacom Driver</title>

      <para>
        Xorg Wacom Driver Pakken inneholder X.Org X11 
        driveren og SDK-en for Wacom og Wacom lignende nettbrett. Det er ikke 
        nødvendig å bruke et Wacom nettbrett,
        xf86-input-evdev driveren kan håndtere disse 
        enhetene uten problemer.
      </para>

      <itemizedlist spacing="compact">
        <listitem>
          <para>
            Nedlasting: <ulink url="&xorg-wacom-driver-download;"/>
          </para>
        </listitem>
      </itemizedlist>

      <bridgehead renderas="sect4">Xorg Wacom Driver Avhengigheter</bridgehead>

      <bridgehead renderas="sect5">Påkrevd</bridgehead>
      <para role="required">
        <xref linkend="xorg-server"/>
      </para>

    </sect3>

    <sect3 role="kernel" id="xorg-wacom-driver-kernel">
      <title>Kjernekonfigurasjon</title>

      <para>
        For å bruke et Wacom nettbrett med USB grensesnitt, aktiver følgende 
        alternativer i kjernekonfigurasjonen og kompiler på nytt. Merk at andre 
        konfigurasjonsalternativer kan være nødvendige for nettbrett med et 
        serielt eller Bluetooth grensesnitt:
      </para>

    <xi:include xmlns:xi="http://www.w3.org/2001/XInclude"
      href="x7driver-wacom-kernel.xml"/>

      <indexterm zone="xorg-wacom-driver xorg-wacom-driver-kernel">
        <primary sortas="d-xorg-wacom-driver">xorg-wacom-driver</primary>
      </indexterm>
    </sect3>

    <sect3 role="installation">
      <title>Installation of Xorg Wacom Driver</title>

      <para>
        Installer Xorg Wacom Driver ved å kjøre 
        følgende kommandoer:
      </para>

<screen revision="sysv"><userinput>./configure $XORG_CONFIG --with-systemd-unit-dir=no &amp;&amp;
make</userinput></screen>

      <para>
        Nå, som <systemitem class="username">root</systemitem> bruker:
      </para>

<screen role="root"><userinput>make install</userinput></screen>
    </sect3>

    <sect3 role="commands">
      <title>Parameterforklaringer</title>

      &options-configure;

    </sect3>

    <sect3 role="content">
      <title>Innhold</title>

      <segmentedlist>
        <segtitle>Installerte Programmer</segtitle>
        <segtitle>Installert Xorg Driver</segtitle>

        <seglistitem>
          <seg>
            isdv4-serial-debugger, isdv4-serial-inputattach, og xsetwacom
          </seg>
          <seg>
            wacom_drv
          </seg>
        </seglistitem>
      </segmentedlist>

      <variablelist>
        <bridgehead renderas="sect4">Korte Beskrivelser</bridgehead>
        <?dbfo list-presentation="list"?>
        <?dbhtml list-presentation="table"?>

        <varlistentry id="xsetwacom">
          <term><command>xsetwacom</command></term>
          <listitem>
            <para>
              er et kommandolinjeverktøy som brukes til å spørre 
              og endre Wacom driverinnstillinger
            </para>
            <indexterm zone="xorg-wacom-driver xsetwacom">
              <primary sortas="b-xsetwacom">xsetwacom</primary>
            </indexterm>
          </listitem>
        </varlistentry>

        <varlistentry id="wacom_drv">
          <term><filename class="libraryfile">wacom_drv</filename></term>
          <listitem>
            <para>
              er en Xorg inndatadriver for Wacom enheter
            </para>
            <indexterm zone="xorg-wacom-driver wacom_drv">
              <primary sortas="c-wacom_drv">wacom_drv</primary>
            </indexterm>
          </listitem>
        </varlistentry>

      </variablelist>

    </sect3>

  </sect2>
