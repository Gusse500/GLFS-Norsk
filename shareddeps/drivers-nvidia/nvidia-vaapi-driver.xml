<sect1 id="nvidia-vaapi-driver" xreflabel="NVIDIA-VA-API-Driver-&nvidia-vaapi-driver-version;">
  <?dbhtml filename="nvidia-vaapi-driver.html"?>

  <title>NVIDIA-VA-API-Driver-&nvidia-vaapi-driver-version;</title>

  <indexterm zone="nvidia-vaapi-driver">
    <primary sortas="a-nvidia-vaapi-driver">NVIDIA-VA-API-Driver</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til NVIDIA-VA-API-Driver</title>

    <para>
      NVIDIA-VA-API-Driver pakken inneholder en VA-API driver for NVIDIA, 
      bruker NVDEC under panseret uten å kreve
      CUDA <command>nvcc</command> kompilator. Den støtter ikke koding, 
      men dekoding for diverse kodeker.
    </para>

    &meson-cross;

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting: <ulink url="&nvidia-vaapi-driver-download;"/>
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">NVIDIA-VA-API-Driver Avhengigheter</bridgehead>

    <para role="required">
      <xref linkend="libdrm"/>,
      <xref linkend="libva"/>,
      <xref linkend="nv-codec-headers"/>, og
      &opengl;
    </para>

    <para role="recommended">
      <xref linkend="gstreamer-suite"/> (Kreves for VP9 kodekstøtte, 
      ofte brukt for strømmesider som YouTube og Twitch)
    </para>

    <para role="optional">
      &nvidia; (Kjørefilens åpne kjernemodulfiler 
      for deklarasjonsregenerering)
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av NVIDIA-VA-API-Driver</title>

    <para>
      Installer NVIDIA-VA-API-Driver ved å kjøre følgende 
      kommandoer:
    </para>

<screen><userinput>mkdir build &amp;&amp;
cd    build &amp;&amp;

meson setup --prefix=/usr --buildtype=release .. &amp;&amp;
ninja</userinput></screen>

    <para>
      Nå, som &root; bruker:
    </para>

<screen role="root"><userinput>ninja install</userinput></screen>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av lib32-NVIDIA-VA-API-Driver</title>

    <para>
      Installer lib32-NVIDIA-VA-API-Driver ved å kjøre følgende 
      kommandoer:
    </para>

<screen><userinput>rm -rf * &amp;&amp;
meson setup --prefix=/usr            \
            --buildtype=release      \
            --cross-file=lib32       \
            .. &amp;&amp;

ninja</userinput></screen>

    <para>
      Nå, som &root; bruker:
    </para>

<screen role="root"><userinput>DESTDIR=$PWD/DESTDIR ninja install    &amp;&amp;
cp -Rv DESTDIR/usr/lib32/* /usr/lib32 &amp;&amp;
rm -rf DESTDIR                        &amp;&amp;
ldconfig</userinput></screen>

  </sect2>

