<sect1 id="rust-bindgen" xreflabel="rust-bindgen-&rust-bindgen-version;">
  <?dbhtml filename="rust-bindgen.html"?>

  <title>rust-bindgen-&rust-bindgen-version;</title>

  <indexterm zone="rust-bindgen">
    <primary sortas="a-rust-bindgen">rust-bindgen</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til rust-bindgen</title>

    <para>
      Genererer automatisk Rust FFI bindinger til C biblioteker (og noen C++ biblioteker).
    </para>

    &build-use-internet;

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting: <ulink url="&rust-bindgen-download;"/>
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">rust-bindgen Avhengigheter</bridgehead>

    <para role="required">
      <xref linkend="llvm"/> med Clang og
      <xref linkend="rustc"/>
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av rust-bindgen</title>
    <para>
      Installer rust-bindgen ved å kjøre følgende 
      kommandoer:
    </para>

<screen><userinput>cargo build --release</userinput></screen>

    <para>
      Nå, som <systemitem class="username">root</systemitem> bruker:
    </para>

<screen role="root"><userinput>&install-exec; target/release/bindgen -t /usr/bin/</userinput></screen>

    <para>
      Fortsatt som &root; bruker, installer Bash og Zsh utførelse 
      støttefilene 
    </para>

<screen role='root'><userinput>bindgen --generate-shell-completions bash \
    &gt; /usr/share/bash-completion/completions/bindgen &amp;&amp;
bindgen --generate-shell-completions zsh  \
    &gt; /usr/share/zsh/site-functions/_bindgen</userinput></screen>

  </sect2>

