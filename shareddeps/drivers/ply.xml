  <sect2 role="package">
    <title>Introduksjon til ply</title>

    <para>
      ply er en null-avhengighet Python 
      implementering av de tradisjonelle parseverktøyene lex og yacc.
    </para>

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting: <ulink url="&ply-download;"/>
        </para>
      </listitem>
    </itemizedlist>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av ply</title>

    <para>
      Bygg modulen:
    </para>

<screen><userinput>pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD</userinput></screen>

    <para>
      Nå installer Python som
      <systemitem class="username">root</systemitem> bruker:
    </para>

<screen role="root"><userinput>pip3 install --no-index --find-links=dist --no-cache-dir --no-user ply</userinput></screen>

  </sect2>

