  <!ENTITY % general-entities SYSTEM "../../general.ent">
  %general-entities;

  <!ENTITY cython-root "https://github.com/cython/cython/releases/download">
  <!ENTITY cython-download
    "&cython-root;/&cython-version;/cython-&cython-version;.tar.gz">
]>

<sect1 id="cython" xreflabel="Cython-&cython-version;">
  <?dbhtml filename="cython.html"?>

  <title>Cython-&cython-version;</title>

  <indexterm zone="cython">
    <primary sortas="a-cython">cython</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til Cython</title>

    <para>
      Cython pakken inneholder en kompilator for å 
      skrive C utvidelser for Python språket.
    </para>

    &long-build-time;

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting: <ulink url="&cython-download;"/>
        </para>
      </listitem>
    </itemizedlist>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av Cython</title>

    <para>
      Bygg modulen:
    </para>

<screen><userinput>pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD</userinput></screen>

    <para>
      Installer modulen som <systemitem class="username">root</systemitem> bruker:
    </para>

<screen role="root"><userinput>pip3 install --no-index --find-links=dist --no-cache-dir --no-user Cython</userinput></screen>

  </sect2>

  <sect2 role="content">
    <title>Innhold</title>

    <segmentedlist>
      <segtitle>Installerte Programmer</segtitle>
      <segtitle>Installerte Biblioteker</segtitle>
      <segtitle>Installerte Mapper</segtitle>

      <seglistitem>
        <seg>
          cydbg, cython, og cythonize
        </seg>
        <seg>
          Ingen
        </seg>
        <seg>
          /usr/lib/python&python3-majorver;/site-packages/Cython,
          /usr/lib/python&python3-majorver;/site-packages/Cython-&cython-version;.dist-info,
          og /usr/lib/python&python3-majorver;/site-packages/pyximport
        </seg>
      </seglistitem>
    </segmentedlist>

    <variablelist>
      <bridgehead renderas="sect3">Korte Beskrivelser</bridgehead>
      <?dbfo list-presentation="list"?>
      <?dbhtml list-presentation="table"?>

      <varlistentry id="cydbg">
        <term><command>cydbg</command></term>
        <listitem>
          <para>
            er Cython feilsøkingsverktøy
          </para>
          <indexterm zone="cython cydbg">
            <primary sortas="b-cydbg">cydbg</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="cython-bin">
        <term><command>cython</command></term>
        <listitem>
          <para>
            er en kompilator for kode skrevet i Cython
             språket. Den sender ut et C/C++ program som kan 
            kompileres med en C/C++ kompilator
          </para>
          <indexterm zone="cython cython-bin">
            <primary sortas="b-cython-bin">cython-bin</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="cythonize">
        <term><command>cythonize</command></term>
        <listitem>
          <para>
            er en kompilator for kode skrevet i Cython
             språket. Den sender ut en utvidelsesmodul som kan 
            importeres direkte fra Python
          </para>
          <indexterm zone="cython cythonize">
            <primary sortas="b-cythonize">cythonize</primary>
          </indexterm>
        </listitem>
      </varlistentry>
    </variablelist>

  </sect2>

</sect1>
