<sect1 id="mako" xreflabel="mako-&mako-version;">
  <?dbhtml filename="mako.html"?>

  <title>Mako-&mako-version;</title>

  <indexterm zone="mako">
    <primary sortas="a-mako">mako</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til Mako</title>

    <para>
      Mako er en Python modul som implementerer 
      hyperrask og lett laging av maler for Python plattformen.
    </para>

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting: <ulink url="&mako-download;"/>
        </para>
      </listitem>
    </itemizedlist>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av Mako</title>

    <para>
      Bygg modulen:
    </para>

<screen><userinput>pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD</userinput></screen>

    <para>
      Installer modulen som <systemitem class="username">root</systemitem> bruker:
    </para>

<screen role="root"><userinput>pip3 install --no-index --find-links=dist --no-cache-dir --no-user Mako</userinput></screen>

  </sect2>

  <sect2 role="content">
    <title>Innhold</title>

    <segmentedlist>
      <segtitle>Installert Program</segtitle>
      <segtitle>Installerte Biblioteker</segtitle>
      <segtitle>Installerte Mapper</segtitle>

      <seglistitem>
        <seg>
          mako-render
        </seg>
        <seg>
          Ingen
        </seg>
        <seg>
          /usr/lib/python&python3-majorver;/site-packages/mako og
          /usr/lib/python&python3-majorver;/site-packages/mako-&mako-version;.dist-info
        </seg>
      </seglistitem>
    </segmentedlist>

    <variablelist>
      <bridgehead renderas="sect3">Korte Beskrivelser</bridgehead>
      <?dbfo list-presentation="list"?>
      <?dbhtml list-presentation="table"?>

      <varlistentry id="mako-render">
        <term><command>mako-render</command></term>
        <listitem>
          <para>
            gjengir en mal
          </para>
          <indexterm zone="mako mako-render">
            <primary sortas="c-mako-render">mako-render</primary>
          </indexterm>
        </listitem>
      </varlistentry>
    </variablelist>

  </sect2>

</sect1>
