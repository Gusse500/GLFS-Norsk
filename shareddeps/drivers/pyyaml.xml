  <sect2 role="package">
    <title>Introduksjon til PyYAML</title>

    <para>
      PyYAML er en Python modul som implementerer 
      neste generasjons YAML analysator og sender.
    </para>

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting (HTTP): <ulink url="&pyyaml-download-http;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Nedlasting (FTP): <ulink url="&pyyaml-download-ftp;"/>
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">PyYAML Avhengigheter</bridgehead>

    <bridgehead renderas="sect4">Påkrevd</bridgehead>
    <para role="required">
      <xref linkend="cython"/> og <xref linkend="libyaml"/>
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av PyYAML</title>

    <para>
      Bygg modulen:
    </para>

<screen><userinput>pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD</userinput></screen>

    <para>
      Installer modulen som <systemitem class="username">root</systemitem> bruker:
    </para>

<screen role="root"><userinput>pip3 install --no-index --find-links=dist --no-cache-dir --no-user PyYAML</userinput></screen>

  </sect2>

