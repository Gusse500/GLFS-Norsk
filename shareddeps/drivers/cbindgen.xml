<sect1 id="cbindgen" xreflabel="Cbindgen-&cbindgen-version;">
  <?dbhtml filename="cbindgen.html"?>

  <title>Cbindgen-&cbindgen-version;</title>

  <indexterm zone="cbindgen">
    <primary sortas="a-cbindgen">cbindgen</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til Cbindgen</title>

    <para>
      Cbindgen kan brukes til å generere C bindinger 
      for Rust kode.
    </para>

    &build-use-internet;

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting (HTTP): <ulink url="&cbindgen-download-http;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Nedlasting (FTP): <ulink url="&cbindgen-download-ftp;"/>
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">cbindgen Avhengigheter</bridgehead>

    <bridgehead renderas="sect4">Påkrevd</bridgehead>
    <para role="required">
      <xref linkend="rustc"/>
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av cbindgen</title>
    <para>
      Installer cbindgen ved å kjøre følgende 
      kommandoer:
    </para>

<screen><userinput>cargo build --release</userinput></screen>

    <para>
      For å teste resultatene, utsted: <command>cargo test --release</command>.
      Tre tester i <filename>profile.rs</filename> er kjent for å mislykkes fordi 
      de prøver å bruke noen ustabile Rust funksjoner som er deaktivert i GLFS.
    </para>

    <para>
      Nå, som <systemitem class="username">root</systemitem> bruker:
    </para>

<screen role="root"><userinput>install -v -m755 target/release/cbindgen /usr/bin/</userinput></screen>

  </sect2>

