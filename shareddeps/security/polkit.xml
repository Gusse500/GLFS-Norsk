<sect1 id="polkit" xreflabel="Polkit-&polkit-version;">
  <?dbhtml filename="polkit.html"?>


  <title>Polkit-&polkit-version;</title>

  <indexterm zone="polkit">
    <primary sortas="a-Polkit">Polkit</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til Polkit</title>

    <para>
      Polkit er et verktøysett for å definere og håndtere autorisasjoner. 
      Det brukes til å tillate uprivilegerte prosesser å kommunisere med 
      privilegerte prosesser.
    </para>

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting: <ulink url="&polkit-download;"/>
        </para>
      </listitem>
    </itemizedlist>

