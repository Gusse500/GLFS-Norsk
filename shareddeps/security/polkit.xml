        <listitem>
          <para>
            inneholder Polkit autorisasjons API funksjonene
          </para>
          <indexterm zone="polkit libpolkit-gobject-1">
            <primary sortas="c-libpolkit-gobject-1">libpolkit-gobject-1</primary>
          </indexterm>
        </listitem>
      </varlistentry>

    </variablelist>

