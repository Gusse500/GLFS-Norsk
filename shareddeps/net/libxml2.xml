<sect1 id="libxml2" xreflabel="libxml2-&libxml2-version;">
  <?dbhtml filename="libxml2.html"?>

  <title>libxml2-&libxml2-version;</title>

  <indexterm zone="libxml2">
    <primary sortas="a-libxml2">libxml2</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til libxml2</title>

    <para>
      libxml2 pakken inneholder biblioteker og verktøy som brukes til å 
      analysere XML filer.
    </para>

    &abi-break;

    &meson-cross;

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting: <ulink url="&libxml2-download;"/>
        </para>
      </listitem>
    </itemizedlist>

