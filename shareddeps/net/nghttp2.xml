<sect1 id="nghttp2" xreflabel="nghttp2-&nghttp2-version;">
  <?dbhtml filename="nghttp2.html"?>

  <title>nghttp2-&nghttp2-version;</title>

  <indexterm zone="nghttp2">
    <primary sortas="a-nghttp2">nghttp2</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til nghttp2</title>

    <para>
      nghttp2 er en implementering av HTTP/2 og dens 
      deklarasjons komprimeringsalgoritme, HPACK. Pakker bruker dette til å 
      støtte HTTP/2, som i noen tilfeller er direkte nødvendig.
    </para>

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting: <ulink url="&nghttp2-download;"/>
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">nghttp2 Avhengigheter</bridgehead>

    <para role="recommended">
      <xref linkend="libxml2"/>
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av nghttp2</title>

    <para>
      Installer nghttp2 ved å kjøre følgende 
      kommandoer:
    </para>

<screen><userinput>./configure --prefix=/usr     \
            --disable-static  \
            --enable-lib-only \
            --docdir=/usr/share/doc/nghttp2-&nghttp2-version; &amp;&amp;
make</userinput></screen>

    <para>
      Nå, som &root; bruker:
    </para>

<screen role="root"><userinput>make install</userinput></screen>

  </sect2>

  <sect2 role="installation">
    <title>lib32 Installasjon av nghttp2</title>

    <para>
      Installer lib32-nghttp2 ved å kjøre følgende kommandoer:
    </para>

<screen><userinput>CC="gcc -m32" CXX="g++ -m32"         \
PKG_CONFIG_PATH=/usr/lib32/pkgconfig \
./configure --prefix=/usr            \
            --libdir=/usr/lib32      \
            --host=i686-pc-linux-gnu \
            --disable-static         \
            --enable-lib-only       &amp;&amp;
make</userinput></screen>

    <para>
      Nå, som &root; bruker:
    </para>

<screen role="root"><userinput>make DESTDIR=$PWD/DESTDIR install    &amp;&amp;
cp -vr DESTDIR/usr/lib32/* /usr/lib32 &amp;&amp;
rm -rf DESTDIR                        &amp;&amp;
ldconfig</userinput></screen>

  </sect2>

  <sect2 role="commands">
    <title>Parameterforklaringer</title>

    &options-configure;

    &static-libraries;

    <para>
      <parameter>--enable-lib-only</parameter>: Ber byggesystemet om bare å 
      bygge <filename class="libraryfile">libnghttp2</filename> ettersom hele 
      pakken er unødvendig og trekker inn flere avhengigheter.
    </para>

  </sect2>

