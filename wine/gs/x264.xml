  <sect2 role="package">
    <title>Introduksjon til x264</title>

    <para>
      x264 pakken tilbyr et bibliotek for koding av videostrømmer i 
      H.264/MPEG-4 AVC formatet.
    </para>

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting: <ulink url="&x264-download;"/>
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">x264 Avhengigheter</bridgehead>

    <bridgehead renderas="sect4">Anbefalt</bridgehead>
    <para role="recommended">
      <xref linkend="nasm"/>
    </para>

    <bridgehead renderas="sect4">Valgfri</bridgehead>
    <para role="optional">
      <ulink url="https://github.com/FFMS/ffms2">ffms2</ulink>,
      <ulink url="https://github.com/gpac/gpac/releases/">gpac</ulink> eller
      <ulink url="https://github.com/l-smash/l-smash">liblsmash</ulink>
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av x264</title>

<!--
    <note>
      <para>
        Denne pakkens tarball utvides til <filename class='directory'>x264</filename>.
      </para>
    </note>
-->

    <para>
      Installer x264 ved å kjøre følgende 
      kommandoer:
    </para>

<screen><userinput>./configure --prefix=/usr \
            --enable-shared \
            --disable-cli &amp;&amp;

make</userinput></screen>

    <para>
      Denne pakken leveres ikke med en testpakke.
    </para>

    <para>
      Nå, som <systemitem class="username">root</systemitem> bruker:
    </para>

<screen role="root"><userinput>make install</userinput></screen>

  </sect2>


  <sect2 role="installation">
    <title>lib32 Installasjon av x264</title>

    <para>
      Installer lib32-x264 ved å kjøre følgende 
      kommandoer:
    </para>

<screen><userinput>make distclean &amp;&amp;
CC="gcc -m32" CXX="g++ -m32"         \
PKG_CONFIG_PATH=/usr/lib32/pkgconfig \
./configure --prefix=/usr            \
            --libdir=/usr/lib32      \
            --host=i686-pc-linux-gnu \
            --enable-shared          \
            --disable-cli &amp;&amp;

make</userinput></screen>

    <para>
      Denne pakken leveres ikke med en testpakke.
    </para>

    <para>
      Nå, som <systemitem class="username">root</systemitem> bruker:
    </para>

<screen role="root"><userinput>make DESTDIR=$PWD/DESTDIR install     &amp;&amp;
cp -vr DESTDIR/usr/lib32/* /usr/lib32 &amp;&amp;
rm -rf DESTDIR                        &amp;&amp;
ldconfig</userinput></screen>

  </sect2>

  <sect2 role="commands">
    <title>Parameterforklaringer</title>

    &options-configure;

    <para>
      <parameter>--disable-cli</parameter>: Denne bryteren deaktiverer bygging 
      av kommandolinjekoderen, som er overflødig siden den krever FFmpeg for de 
      fleste inndataformatene.
    </para>

    <para>
      <option>--disable-asm</option>: Bruk denne bryteren hvis du ikke 
      installerte NASM.
    </para>

  </sect2>

