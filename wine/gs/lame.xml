        </listitem>
      </varlistentry>

      <varlistentry id="libmp3lame">
        <term><filename class="libraryfile">libmp3lame</filename></term>
        <listitem>
          <para>
            tilbyr funksjonene som er nødvendige for å konvertere rå PCM og 
            WAV filer til MP3 filer
          </para>
          <indexterm zone="lame libmp3lame">
            <primary sortas="c-libmp3lame">libmp3lame</primary>
          </indexterm>
        </listitem>
      </varlistentry>

    </variablelist>

  </sect2>

