<sect1 id="lame" xreflabel="LAME-&lame-version;">
  <?dbhtml filename="lame.html"?>


  <title>LAME-&lame-version;</title>

  <indexterm zone="lame">
    <primary sortas="a-LAME">LAME</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til LAME</title>

    <para>
      LAME pakken inneholder en MP3 koder og eventuelt en 
      MP3 rammeanalysator. Dette er nyttig for å lage og 
      analysere komprimerte lydfiler.
    </para>

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting: <ulink url="&lame-download;"/>
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">LAME Avhengigheter</bridgehead>

    <bridgehead renderas="sect4">Valgfri</bridgehead>
    <para role="optional">
      <ulink url="https://dmalloc.com/">Dmalloc</ulink>,
      <ulink url="https://linux.softpedia.com/get/Programming/Debuggers/Electric-Fence-3305.shtml/">Electric Fence</ulink>,
      <xref linkend="libsndfile"/> og
      <xref linkend="nasm"/>
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av LAME</title>

    <!-- Taken from Fedora -->
    <para>
      Forhindre at kildekodemappen feilaktig blir hardkodet som en søkesti for 
      delt bibliotek i de installerte programmene:
    </para>

<screen><userinput>sed -i -e 's/^\(\s*hardcode_libdir_flag_spec\s*=\).*/\1/' configure</userinput></screen>

    <para>
      Installer LAME ved å kjøre følgende 
      kommandoer:
    </para>

<screen><userinput>./configure --prefix=/usr   \
            --enable-mp3rtp \
            --disable-static &amp;&amp;

make</userinput></screen>

    <para>
      Nå, som <systemitem class="username">root</systemitem> bruker:
    </para>

<screen role="root"><userinput>make pkghtmldir=/usr/share/doc/lame-&lame-version; install</userinput></screen>

  </sect2>

  <sect2 role="installation">
    <title>lib32 Installasjon av LAME</title>

    <para>
      Installer lib32-LAME ved å kjøre følgende 
      kommandoer:
    </para>

<screen><userinput>make distclean &amp;&amp;
CC="gcc -m32" CXX="g++ -m32"         \
PKG_CONFIG_PATH=/usr/lib32/pkgconfig \
./configure --prefix=/usr            \
            --libdir=/usr/lib32      \
            --host=i686-pc-linux-gnu \
            --enable-mp3rtp          \
            --disable-static         \
            --enable-nasm &amp;&amp;

make</userinput></screen>

    <para>
      Nå, som <systemitem class="username">root</systemitem> bruker:
    </para>

<screen role="root"><userinput>make DESTDIR=$PWD/DESTDIR install     &amp;&amp;
cp -vr DESTDIR/usr/lib32/* /usr/lib32 &amp;&amp;
rm -rf DESTDIR                        &amp;&amp;
ldconfig</userinput></screen>

  </sect2>

  <sect2 role="commands">
    <title>Parameterforklaringer</title>

    &options-configure;

    <para>
      <parameter>--enable-mp3rtp</parameter>: Denne bryteren aktiverer bygging 
      av kode-til-RTP programmet.
    </para>

    &static-libraries;

    <para>
      <parameter>--enable-nasm</parameter>: Dette alternativet aktiverer bruk av
      <xref linkend="nasm"/> for å kompilere optimaliserte assemblerrutiner for 
      32-bit. Dette er ikke aktivert for x86_64 da det ikke har noen effekt.
    </para>

  </sect2>

  <sect2 role="content">
    <title>Innhold</title>

    <segmentedlist>
      <segtitle>Installerte Programmer</segtitle>
      <segtitle>Installert Bibliotek</segtitle>
      <segtitle>Installerte Mapper</segtitle>

      <seglistitem>
        <seg>
          lame og mp3rtp
        </seg>
        <seg>
