      <ulink url="&blfs-svn;/multimedia/libass.html">libass</ulink>,
      <xref linkend="fdk-aac"/>,
      <xref linkend="freetype2-pass2"/>,
      <xref linkend="lame"/>,
      <xref linkend="libvorbis"/>,
      <xref linkend="libvpx"/>,
      <xref linkend="opus"/>,
      <xref linkend="x264"/>,
      <xref linkend="x265"/>, og
      <xref linkend="nasm"/>
    </para>

    <bridgehead renderas="sect4">Anbefalt for skrivebord bruk</bridgehead>
    <para role="recommended">
      <xref linkend="alsa-lib"/>,
      <xref linkend="libva"/>, og
      <xref linkend="sdl2"/>
    </para>

    <bridgehead renderas="sect4">Anbefalt for systemer med Intel-video</bridgehead>
    <para role="recommended">
      <xref linkend="libvdpau"/> og
      <xref linkend="libvdpau-va-gl"/>
    </para>

    <bridgehead renderas="sect4">Valgfritt for systemer med NVIDIA</bridgehead>
    <para role="optional">
      <ulink url="&slfs-website;/general/cuda.html">CUDA</ulink> og
      <ulink url="&slfs-website;/general/nv-codec-headers.html">nv-codec-headers</ulink>
    </para>

    <bridgehead renderas="sect4">Valgfri</bridgehead>
    <para role="optional">
      Fullstendig liste over valgfrie avhengigheter finnes i
      <ulink url="&blfs-svn;/multimedia/ffmpeg.html">BLFS FFmpeg siden</ulink>.
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av FFmpeg</title>

    <para>
      Først, installer en oppdatering som legger til et API som er nødvendig 
      for at noen pakker skal kunne bygges:
      <!-- qtwebengine -->
    </para>

<screen><userinput remap="pre">patch -Np1 -i ../ffmpeg-&ffmpeg-version;-chromium_method-1.patch</userinput></screen>

    <para>
      Nå fiks et problem forårsaket av den nyeste versjonen av <xref linkend="x265"/>:
    </para>

<screen><userinput remap="pre">sed -e 's/X265_BUILD >= 210/(&amp;) \&amp;\&amp; (X265_BUILD &lt; 213)/' \
    -i libavcodec/libx265.c</userinput></screen>

    <para>
      Installer FFmpeg ved å kjøre følgende 
      kommandoer:
    </para>

<screen><userinput>./configure --prefix=/usr        \
            --enable-gpl         \
            --enable-version3    \
            --enable-nonfree     \
            --disable-static     \
            --enable-shared      \
            --disable-debug      \
            --enable-libaom      \
            --enable-libfdk-aac  \
            --enable-libfreetype \
            --enable-libmp3lame  \
            --enable-libopus     \
            --enable-libvorbis   \
            --enable-libvpx      \
            --enable-libx264     \
            --enable-libx265     \
            --enable-openssl<!--     \
            - -ignore-tests=enhanced-flv-av1-->     \
            --docdir=/usr/share/doc/ffmpeg-&ffmpeg-version; &amp;&amp;

make &amp;&amp;

gcc tools/qt-faststart.c -o tools/qt-faststart</userinput></screen>

    <para>
      Nå, som <systemitem class="username">root</systemitem> bruker:
    </para>

<screen role="root"><userinput>make install &amp;&amp;

install -v -m755    tools/qt-faststart /usr/bin &amp;&amp;
install -v -m755 -d           /usr/share/doc/ffmpeg-&ffmpeg-version; &amp;&amp;
install -v -m644    doc/*.txt /usr/share/doc/ffmpeg-&ffmpeg-version;</userinput></screen>

  </sect2>

  <sect2 role="installation">
    <title>lib32 Installasjon av FFmpeg</title>

    <para>
      Installer lib32-FFmpeg ved å kjøre følgende 
      kommandoer:
    </para>

<screen><userinput>make distclean &amp;&amp;
./configure --prefix=/usr                             \
            --libdir=/usr/lib32                       \
            --shlibdir=/usr/lib32                     \
            --cc="gcc -m32"                           \
            --pkg-config=i686-pc-linux-gnu-pkg-config \
            --enable-gpl                              \
            --enable-version3                         \
            --enable-nonfree                          \
            --disable-static                          \
            --enable-shared                           \
            --disable-debug                           \
            --enable-libaom                           \
            --enable-libfdk-aac                       \
            --enable-libfreetype                      \
            --enable-libmp3lame                       \
            --enable-libopus                          \
            --enable-libvorbis                        \
            --enable-libvpx                           \
            --enable-libx264                          \
            --enable-libx265                          \
            --enable-openssl<!--                          \
            - -ignore-tests=enhanced-flv-av1--> &amp;&amp;

make</userinput></screen>

    <para>
      Nå, som <systemitem class="username">root</systemitem> bruker:
    </para>

<screen role="root"><userinput>make DESTDIR=$PWD/DESTDIR install     &amp;&amp;
cp -vr DESTDIR/usr/lib32/* /usr/lib32 &amp;&amp;
rm -rf DESTDIR                        &amp;&amp;
ldconfig</userinput></screen>

  </sect2>

  <sect2 role="commands">
    <title>Parameterforklaringer</title>

    &options-configure;

    <para>
      <parameter>--enable-libfreetype</parameter>: Aktiverer
      Freetype støtte.
    </para>

    <para>
      <parameter>--enable-gpl</parameter>: Aktiverer bruk av GPL kode og støtte 
      for etterbehandling, swscale og mange andre funksjoner.
    </para>

    <para>
      <parameter>--enable-version3</parameter>: Aktiverer bruk av (L)GPL 
      versjon 3 kode.
    </para>

    <para>
      <parameter>--enable-nonfree</parameter>: Aktiverer bruk av ikke-fri kode. 
      Merk at de resulterende bibliotekene og binærfilene ikke vil kunne distribueres på nytt.
    </para>

    &static-libraries;

    <para>
      <parameter>--enable-shared</parameter>: Aktiverer bygging av delte 
      biblioteker, ellers bygges og installeres bare statiske biblioteker.
    </para>

    <para>
      <parameter>--disable-debug</parameter>: Deaktiverer bygging av 
      feilsøkingssymboler i programmene og bibliotekene.
    </para>

    <para>
      <parameter>--enable-libaom</parameter>: Aktiverer AV1 lyd og video 
      dekoding via <filename class="libraryfile">libaom</filename>.
    </para>

    <para>
      <parameter>--enable-libfdk-aac</parameter>: Aktiverer AAC lydkoding via
      <filename class="libraryfile">libfdk-aac</filename>.
    </para>

    <para>
      <parameter>--enable-libmp3lame</parameter>: Aktiverer MP3 lydkoding
      via <filename class="libraryfile">libmp3lame</filename>.
    </para>
<!--
    <para>
      <parameter>- -enable-libvorbis</parameter>
      <parameter>- -enable-libtheora</parameter>: Aktiverer
      Theora videokoding via <filename
      class="libraryfile">libvorbis</filename> og <filename
      class="libraryfile">libtheora</filename>.
    </para>
-->
    <para>
      <parameter>--enable-libvorbis</parameter>
      <parameter>--enable-libvpx</parameter>: Aktiverer WebM
      koding via <filename class="libraryfile">libvorbis</filename> og
      <filename class="libraryfile">libvpx</filename>.
    </para>

    <para>
      <parameter>--enable-libx264</parameter>: Aktiverer høykvalitets
      H.264/MPEG-4 AVC koding via <filename
      class="libraryfile">libx264</filename>.
    </para>

    <para>
      <parameter>--enable-libx265</parameter>: Aktiverer høykvalitets
      H.265/HEVC koding via <filename
      class="libraryfile">libx265</filename>.
    </para>

    <para>
      <parameter>--enable-openssl</parameter>:
      Aktiverer HTTPS protokollen for nettverksstrømmer.
    </para>

    <para>
      <option>--enable-libdrm</option>: Bruk denne bryteren hvis
      <xref linkend="libdrm"/> er installert for å bygge <quote>kmsgrab</quote>
      inndatamodul som er nyttig for skjermopptak eller strømming.
    </para>

    <para>
      <option>--enable-nvenc --enable-nvdec</option>: Disse alternativene 
      aktiverer maskinvareakselerasjon for NVIDIA GPU-er, og avhenger av de 
      valgfrie avhengighetene for systemer med NVIDIA.
    </para>

    <!--
    <para>
      <parameter>- -disable-vulkan</parameter>: Deaktiverer Vulkan for 
      gjeldende versjon av <xref linkend="vulkan-loader"/> på grunn av 
      en API konflikt.
    </para>
    -->

<!--
    <para>
      <parameter>- -ignore-tests=...</parameter>: Deaktiverer tester som ikke 
      klarer å kjøre på BLFS uten de valgfrie pakkene. AV1 testen er for 
      øyeblikket deaktivert, da den trenger dav1d for å utføre AV1 dekoding på 
      CPU-en. Testen kan fungere hvis du har en GPU som kan dekode AV1, men 
      dette ble ikke testet.
    </para>
-->

    <para>
      <option>--enable-gnutls</option>: Bruk dette alternativet i stedet for
      <parameter>--enable-openssl</parameter>, hvis du vil bruke 
      GnuTLS i stedet for 
      OpenSSL for HTTPS protokollen.
    </para>

    <para>
      <option>--disable-doc</option>: Deaktiverer bygging av HTML dokumentasjon. 
      Dette er bare nødvendig hvis doxygen er installert og du ikke ønsker å 
      bygge HTML dokumentasjonen.
    </para>

    <para>
      <option>--enable-libpulse</option>: Aktiverer støtte for
      Pulseaudio for lydutdata.
    </para>

    <para>
      <command>gcc tools/qt-faststart.c -o tools/qt-faststart</command>: Dette
      bygger <command>qt-faststart</command> programmet som kan endre
      QuickTime formaterte filmer (<filename class="extension">.mov</filename>
      eller <filename class="extension">.mp4</filename>) slik at 
      deklarasjonsinformasjonen er plassert i begynnelsen av filen i stedet for 
      på slutten. Dette gjør at filmfilen kan begynne å spilles av før hele 
      filen er lastet ned.
    </para>

    <note>
      <para>
        Støtte for noen av avhengighetspakkene krever bruk av alternativer som 
        sendes til <command>configure</command> skriptet. Se utdataene
        fra <command>./configure --help</command> for fullstendig informasjon 
        om aktivering av avhengighetspakker.
      </para>
    </note>

  </sect2>

  <sect2 role="content">
    <title>Innhold</title>

    <segmentedlist>
      <segtitle>Installerte Programmer</segtitle>
      <segtitle>Installerte Biblioteker</segtitle>
      <segtitle>Installerte Mapper</segtitle>

      <seglistitem>
        <seg>
          ffmpeg, ffplay, ffprobe, <!--ffserver,--> og qt-faststart
        </seg>
        <seg>
          libavcodec, libavdevice, libavfilter,
          libavformat, libavutil, libpostproc,
          libswresample, og libswscale
        </seg>
        <seg>
          /usr/include/libav{codec,device,filter,format,util},
          /usr/include/libpostproc,
          /usr/include/libsw{resample,scale},
          /usr/share/doc/ffmpeg-&ffmpeg-version;, og
          /usr/share/ffmpeg
        </seg>
      </seglistitem>
    </segmentedlist>

    <variablelist>
      <bridgehead renderas="sect3">Korte Beskrivelser</bridgehead>
      <?dbfo list-presentation="list"?>
      <?dbhtml list-presentation="table"?>

      <varlistentry id="ffmpeg-prog">
        <term><command>ffmpeg</command></term>
        <listitem>
          <para>
            er et kommandolinjeverktøy for å konvertere videofiler, 
            nettverksstrømmer og inndata fra et TV-kort til flere videoformater
          </para>
          <indexterm zone="ffmpeg ffmpeg-prog">
            <primary sortas="b-ffmpeg">ffmpeg</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="ffplay">
        <term><command>ffplay</command></term>
        <listitem>
          <para>
            er en veldig enkel og portabel mediespiller som bruker
            <filename>ffmpeg</filename> biblioteker og SDL biblioteket
          </para>
          <indexterm zone="ffmpeg ffplay">
            <primary sortas="b-ffplay">ffplay</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="ffprobe">
        <term><command>ffprobe</command></term>
        <listitem>
          <para>
            samler informasjon fra multimediestrømmer og skriver den ut på en 
            menneskelig og maskinlesbar måte
          </para>
          <indexterm zone="ffmpeg ffprobe">
            <primary sortas="b-ffprobe">ffprobe</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="qt-faststart">
        <term><command>qt-faststart</command></term>
        <listitem>
          <para>
            flytter indeksfilen til forsiden av QuickTime videoer (mov/mp4)
          </para>
          <indexterm zone="ffmpeg qt-faststart">
            <primary sortas="b-qt-faststart">qt-faststart</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="libavcodec">
        <term><filename class="libraryfile">libavcodec</filename></term>
        <listitem>
          <para>
            er et bibliotek som inneholder FFmpeg kodekene 
            (både koding og dekoding)
          </para>
          <indexterm zone="ffmpeg libavcodec">
            <primary sortas="c-libavcodec">libavcodec</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="libavdevice">
        <term><filename class="libraryfile">libavdevice</filename></term>
        <listitem>
          <para>
            er FFmpeg biblioteket for enhetshåndtering
          </para>
          <indexterm zone="ffmpeg libavdevice">
            <primary sortas="c-libavdevice">libavdevice</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="libavfilter">
        <term><filename class="libraryfile">libavfilter</filename></term>
        <listitem>
          <para>
            er et bibliotek med filtre som kan endre video eller lyd mellom 
            dekoderen og koderen (eller utgangen)
          </para>
          <indexterm zone="ffmpeg libavfilter">
            <primary sortas="c-libavfilter">libavfilter</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="libavformat">
        <term><filename class="libraryfile">libavformat</filename></term>
        <listitem>
          <para>
            er et bibliotek som inneholder filformathåndteringen (mux og demux 
            kode for flere formater) som brukes av <command>ffplay</command> 
            samt å tillate generering av lyd eller videostrømmer
          </para>
          <indexterm zone="ffmpeg libavformat">
            <primary sortas="c-libavformat">libavformat</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="libavresample">
        <term><filename class="libraryfile">libavresample</filename></term>
        <listitem>
          <para>
            er et bibliotek som inneholder funksjoner for resampling av lyd og video.
          </para>
          <indexterm zone="ffmpeg libavresample">
            <primary sortas="c-libavresample">libavresample</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="libavutil">
        <term><filename class="libraryfile">libavutil</filename></term>
        <listitem>
          <para>
            er FFmpeg verktøybiblioteket
          </para>
          <indexterm zone="ffmpeg libavutil">
            <primary sortas="c-libavutil">libavutil</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="libpostproc">
        <term><filename class="libraryfile">libpostproc</filename></term>
        <listitem>
          <para>
            er FFmpegs etterbehandlingsbibliotek
          </para>
          <indexterm zone="ffmpeg libpostproc">
            <primary sortas="c-libpostproc">libpostproc</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="libswresample">
        <term><filename class="libraryfile">libswresample</filename></term>
        <listitem>
          <para>
            er FFmpeg biblioteket for omskalering av lyd, det inneholder 
            funksjoner for å konvertere lydeksempelformater
          </para>
          <indexterm zone="ffmpeg libswresample">
            <primary sortas="c-libswresample">libswresample</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="libswscale">
        <term><filename class="libraryfile">libswscale</filename></term>
        <listitem>
          <para>
            er FFmpeg biblioteket for bildereskalering
          </para>
          <indexterm zone="ffmpeg libswscale">
            <primary sortas="c-libswscale">libswscale</primary>
          </indexterm>
        </listitem>
      </varlistentry>

    </variablelist>

  </sect2>

