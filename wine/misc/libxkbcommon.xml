<sect1 id="libxkbcommon" xreflabel="libxkbcommon-&libxkbcommon-version;">
  <?dbhtml filename="libxkbcommon.html"?>

  <title>libxkbcommon-&libxkbcommon-version;</title>

  <indexterm zone="libxkbcommon">
    <primary sortas="a-libxkbcommon">libxkbcommon</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til libxkbcommon</title>

    <para>
      libxkbcommon er en tastekartkompilator og 
      et støttebibliotek som behandler et redusert delsett av tastekart som 
      definert av XKB spesifikasjonen.
    </para>

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting: <ulink url="&libxkbcommon-download;"/>
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">libxkbcommon Avhengigheter</bridgehead>

    <bridgehead renderas="sect4">Påkrevd</bridgehead>
    <para role="required">
      <xref role="runtime" linkend="xkeyboard-config"/> (kjøretid)
    </para>

    <bridgehead renderas="sect4">Anbefalt</bridgehead>
    <para role="recommended">
       <xref linkend="libxcb"/>,
       <xref linkend="wayland"/>, og
       <xref linkend="wayland-protocols"/>
    </para>

    <bridgehead renderas="sect4">Valgfri</bridgehead>
    <para role="optional">
      <command>Xvfb</command> fra
      <xref linkend='xorg-server'/> eller
      <xref role='nodep' linkend='xwayland'/>
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av libxkbcommon</title>

    <para>
      Installer libxkbcommon ved å kjøre følgende 
      kommandoer:
    </para>

<screen><userinput>mkdir build &amp;&amp;
cd    build &amp;&amp;

meson setup ..            \
      --prefix=/usr       \
      --buildtype=release \
      -D enable-docs=false &amp;&amp;

ninja</userinput></screen>

    <para>
      Nå, som <systemitem class="username">root</systemitem> bruker:
    </para>

<screen role="root"><userinput>ninja install</userinput></screen>

  </sect2>

  <sect2 role="installation">
    <title>lib32 Installasjon av libxkbcommon</title>

    <para>
      Installer lib32-libxkbcommon ved å kjøre følgende 
      kommandoer:
    </para>

<screen><userinput>rm -rf * &amp;&amp;
CC="gcc -m32" CXX="g++ -m32"         \
PKG_CONFIG_PATH=/usr/lib32/pkgconfig \
meson setup ..                       \
      --prefix=/usr                  \
      --libdir=/usr/lib32            \
      --buildtype=release            \
      -D enable-docs=false &amp;&amp;

ninja</userinput></screen>

    <para>
      Nå, som <systemitem class="username">root</systemitem> bruker:
    </para>

<screen role="root"><userinput>DESTDIR=$PWD/DESTDIR ninja install    &amp;&amp;
cp -vr DESTDIR/usr/lib32/* /usr/lib32 &amp;&amp;
rm -rf DESTDIR                        &amp;&amp;
ldconfig</userinput></screen>

  </sect2>

  <sect2 role="commands">
    <title>Parameterforklaringer</title>

    &options-meson;

    &meson-buildtype-release;

    <para>
      <parameter>-D enable-docs=false</parameter>: Denne parameteren deaktiverer 
      bygging av dokumentasjon siden <ulink
      url="&blfs-svn;/general/doxygen.html"></ulink> ikke er bygget.
    </para>

  </sect2>

